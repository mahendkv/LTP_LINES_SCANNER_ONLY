    calculation_valid = core_complete and conditional_count_ok and not drift_rows
    return {
        "gate_version": PARITY_GATE_VERSION,
        "status": status,
        "calculation_valid": calculation_valid,
        "tolerance_points": PARITY_TOLERANCE_POINTS,
        "runtime_website_comparisons": compared,
        "runtime_drift_count": len(drift_rows),
        "runtime_drift_rows": drift_rows,
