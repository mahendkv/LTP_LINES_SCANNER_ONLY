# ---- Website adjacent opposite-option S-Reversal formula -----------------
SREV_GAMMA_COEFFICIENT = 0.5
SREV_DISPLAY_TICK = 0.05
# Tiny outward offsets were selected only on pre-15-July captures to compensate
# for the API exposing five-decimal Greeks after the server used more precision.
SREV_CE_PRECISION_BIAS = 0.0001
SREV_PE_PRECISION_BIAS = 0.0003


def _provided_greek(row: Mapping[str, Any], side: str, name: str) -> Tuple[bool, float]:
    nested = row.get(side, {}) or {}
    direct_keys = {
        ("CE", "delta"): ("cdelta", "ce_delta"),
        ("CE", "gamma"): ("cgamma", "ce_gamma"),
        ("PE", "delta"): ("pdelta", "pe_delta"),
        ("PE", "gamma"): ("pgamma", "pe_gamma"),
    }
    present = False
    for value in (nested.get(name), *(row.get(key) for key in direct_keys[(side, name)])):
        if value is None or str(value).strip() == "":
            continue
        present = True
        parsed = sf(value)
        if parsed != 0.0:
            return True, parsed
    return present, 0.0


def _option_greeks(row: Mapping[str, Any], side: str, spot: float, strike: float, t_years: float) -> Tuple[float, float, str]:
    delta_present, delta = _provided_greek(row, side, "delta")
    gamma_present, gamma = _provided_greek(row, side, "gamma")
    if delta_present or gamma_present:
        source = "PROVIDED" if delta != 0.0 and gamma > 0.0 else "PROVIDED_INCOMPLETE"
        return delta, gamma, source
    iv = _opt(row, side, "impliedVolatility")
    is_call = side == "CE"
    return (
        calc_delta(spot, strike, t_years, iv, is_call),
        calc_gamma(spot, strike, t_years, iv),
        "BLACK_SCHOLES_FROM_IV",
    )


def _complete_option_pair(lower: Mapping[str, Any], upper: Mapping[str, Any], spot: float, t_years: float) -> Tuple[bool, Dict[str, Tuple[float, float, str]]]:
    greeks: Dict[str, Tuple[float, float, str]] = {}
    for label, row in (("LOWER", lower), ("UPPER", upper)):
        strike = sf(row.get("strikePrice"))
        for side in ("CE", "PE"):
            ltp = _opt(row, side, "lastPrice")
            delta, gamma, source = _option_greeks(row, side, spot, strike, t_years)
            greeks[f"{label}_{side}"] = (delta, gamma, source)
            if not (
                ltp > 0.0 and gamma > 0.0
                and (0.0 < delta <= 1.0 if side == "CE" else -1.0 <= delta < 0.0)
            ):
                return False, greeks
    return True, greeks


def _quadratic_roots(c0: float, c1: float, c2: float) -> List[float]:
    if abs(c2) < 1e-15:
        return [] if abs(c1) < 1e-15 else [-c0 / c1]
    discriminant = c1 * c1 - 4.0 * c2 * c0
    if discriminant < 0.0:
        return []
    root = math.sqrt(max(0.0, discriminant))
    q = -0.5 * (c1 + math.copysign(root, c1))
    if abs(q) < 1e-15:
        return [-c1 / (2.0 * c2)]
    return [q / c2, c0 / q]


def _spot_relative_outward_tick(level: float, spot: float) -> float:
    if not (math.isfinite(level) and level > 0.0 and spot > 0.0):
        return 0.0
    move = level - spot
    if abs(move) <= 1e-10:
        return round(spot, 2)
    if move > 0.0:
        steps = math.ceil((move + SREV_CE_PRECISION_BIAS) / SREV_DISPLAY_TICK - 1e-10)
    else:
        steps = math.floor((move - SREV_PE_PRECISION_BIAS) / SREV_DISPLAY_TICK + 1e-10)
    return round(spot + steps * SREV_DISPLAY_TICK, 2)


def _adjacent_crossing(lower: Mapping[str, Any], upper: Mapping[str, Any], spot: float, t_years: float) -> Tuple[float, Dict[str, Any]]:
    low_strike = sf(lower.get("strikePrice"))
    high_strike = sf(upper.get("strikePrice"))
    complete, greeks = _complete_option_pair(lower, upper, spot, t_years)
    debug: Dict[str, Any] = {
        "lower_strike": low_strike,
        "upper_strike": high_strike,
        "complete_pair": complete,
        "greek_sources": {key: value[2] for key, value in greeks.items()},
    }
    if not complete or not (0.0 < low_strike < high_strike):
        return 0.0, debug

    call_ltp = _opt(upper, "CE", "lastPrice")
    put_ltp = _opt(lower, "PE", "lastPrice")
    call_delta, call_gamma, _ = greeks["UPPER_CE"]
    put_delta, put_gamma, _ = greeks["LOWER_PE"]
    c0 = call_ltp - put_ltp
    c1 = call_delta - put_delta
    c2 = SREV_GAMMA_COEFFICIENT * (call_gamma - put_gamma)
    levels = [spot + move for move in _quadratic_roots(c0, c1, c2)]
    levels = [value for value in levels if math.isfinite(value) and value > 0.0]
    if not levels:
        debug.update({"c0": c0, "c1": c1, "c2": c2, "raw_root": 0.0})
        return 0.0, debug
    midpoint = (low_strike + high_strike) / 2.0
    raw_root = min(levels, key=lambda value: abs(value - midpoint))
    displayed = _spot_relative_outward_tick(raw_root, spot)
    debug.update({
        "c0": c0, "c1": c1, "c2": c2,
        "raw_root": raw_root, "displayed_root": displayed,
        "assignment": "BOTH_AT_SPOT" if abs(raw_root - spot) <= 1e-10 else ("CE_LOWER" if raw_root > spot else "PE_UPPER"),
    })
    return displayed, debug


def compute_sreversal_maps(full_rows: Sequence[Mapping[str, Any]], spot: Any, step: Any, t_years: Any) -> Tuple[Dict[Any, float], Dict[Any, float], Dict[str, Any]]:
    sp = sf(spot)
    t = max(sf(t_years), SREV_MIN_T_YEARS)
    ordered = sorted(
        (row for row in full_rows if sf(row.get("strikePrice")) > 0.0),
        key=lambda row: sf(row.get("strikePrice")),
    )
    ce_map: Dict[Any, float] = {}
    pe_map: Dict[Any, float] = {}
    native_ce_count = native_pe_count = 0
    estimated_ce_count = estimated_pe_count = 0
    native_ce_strikes: List[Any] = []
    native_pe_strikes: List[Any] = []

    # Website-native fields are always authoritative when supplied.
    for row in ordered:
        key = strike_key(row.get("strikePrice"))
        ce_native = sf(row.get("calReversal") or row.get("callReversal") or (row.get("CE", {}) or {}).get("sReversal"))
        pe_native = sf(row.get("putReversal") or row.get("peReversal") or (row.get("PE", {}) or {}).get("sReversal"))
        if ce_native > 0.0:
            ce_map[key] = round(ce_native, 2)
            native_ce_count += 1
            native_ce_strikes.append(key)
        if pe_native > 0.0:
            pe_map[key] = round(pe_native, 2)
            native_pe_count += 1
            native_pe_strikes.append(key)

    pair_debug: List[Dict[str, Any]] = []
    complete_pairs = 0
    for lower, upper in zip(ordered, ordered[1:]):
        crossing, debug = _adjacent_crossing(lower, upper, sp, t)
        pair_debug.append(debug)
        if crossing <= 0.0:
            continue
        complete_pairs += 1
        lower_key = strike_key(lower.get("strikePrice"))
        upper_key = strike_key(upper.get("strikePrice"))
        # One crossing is displayed in both adjacent cells.  srev_cell applies
        # Break Out/Break Down according to its relation to spot.
        if lower_key not in ce_map:
            ce_map[lower_key] = crossing
            estimated_ce_count += 1
        if upper_key not in pe_map:
            pe_map[upper_key] = crossing
            estimated_pe_count += 1

    if native_ce_count + native_pe_count and estimated_ce_count + estimated_pe_count:
        source = "MIXED_NATIVE_AND_ADJACENT_CROSS_FALLBACK"
    elif native_ce_count + native_pe_count:
        source = "WEBSITE_NATIVE_FIELDS"
    else:
        source = "LOCAL_ADJACENT_CROSS_TICK_NOT_EXACT"
    return ce_map, pe_map, {
        "formula": "WEBSITE_NATIVE_FIRST_ELSE_ADJACENT_OPPOSITE_OPTION_CROSS",
        "equation": "CALL(next)+delta*dS+0.5*gamma*dS^2 = PUT(lower)+delta*dS+0.5*gamma*dS^2",
        "root_rule": "quadratic root nearest adjacent-strike midpoint",
        "display_rule": "0.05 tick outward from current spot",
        "parity_source": source,
        "exact_website_parity": False,
        "verification_status": "STRUCTURE_CERTIFIED_LOCAL_TICK_NOT_EXACT",
        "global_formula_certified": False,
        "native_ce_count": native_ce_count, "native_pe_count": native_pe_count,
        "estimated_ce_count": estimated_ce_count, "estimated_pe_count": estimated_pe_count,
        "native_ce_strikes": native_ce_strikes, "native_pe_strikes": native_pe_strikes,
        "adjacent_pair_count": max(0, len(ordered) - 1),
        "complete_pair_count": complete_pairs,
        "pair_debug": pair_debug,
        "ce_valid_count": len(ce_map), "pe_valid_count": len(pe_map),
        "certification": dict(PARITY_CERTIFICATION),
    }


def srev_cell(side: str, spot: Any, value: Any) -> str:
    v, sp = sf(value), sf(spot)
    if v <= 0: return "NA"
    if side == "CE" and sp > v + 1e-9: return "BREAK OUT"
    if side == "PE" and sp < v - 1e-9: return "BREAK DOWN"
    return f"{v:.2f}\nACTIVE"


def locked_magical_lines(full_rows: Sequence[Mapping[str, Any]], spot: Any, atm: Any, step: Any, ce_map: Mapping[Any, Any], pe_map: Mapping[Any, Any], resistance_strike: Any, support_strike: Any) -> Tuple[Dict[str, float], Dict[str, Any]]:
    st, sp = sf(step), sf(spot)
    ordered = sorted((nearest_strike(full_rows, r.get("strikePrice")) for r in full_rows), key=sf)
    ordered = list(dict.fromkeys(ordered))
    fallback = nearest_strike(full_rows, sf(atm) or sf(spot))
    res = nearest_strike(full_rows, resistance_strike) if sf(resistance_strike) > 0 else fallback
    sup = nearest_strike(full_rows, support_strike) if sf(support_strike) > 0 else fallback

    def token(side: str, value: Any) -> Tuple[str, float]:
        v = sf(value)
        if v <= 0:
            return "NA", 0.0
        if side == "CE" and sp >= v:
            return "BREAK OUT", v
        if side == "PE" and sp <= v:
            return "BREAK DOWN", v
        return "VALUE", v

    # Anchor the outer lines to the selected EOR/EOS strikes. Searching for the
    # first row with the same display token is unsafe after a break: many deep
    # strikes all display BREAK OUT/BREAK DOWN and the first match can be far
    # away from the selected resistance/support strike.
    try:
        r_idx = ordered.index(res)
    except ValueError:
        r_idx = 0
    try:
        s_idx = ordered.index(sup)
    except ValueError:
        s_idx = 0
    r_max_pain_strike = ordered[min(len(ordered) - 1, r_idx + 2)] if ordered else nearest_strike(full_rows, sf(res) + 2 * st)
    s_max_pain_strike = ordered[max(0, s_idx - 2)] if ordered else nearest_strike(full_rows, sf(sup) - 2 * st)
    strike_map = {
        "R_MaxPain": r_max_pain_strike,
        "EOR_PLUS1": nearest_strike(full_rows, sf(res) + st),
        "EOR": nearest_strike(full_rows, res),
        "EOS": nearest_strike(full_rows, sup),
        "EOS_MINUS1": nearest_strike(full_rows, sf(sup) - st),
        "S_MaxPain": s_max_pain_strike,
    }
    values = {
        "R_MaxPain": sf(ce_map.get(strike_key(strike_map["R_MaxPain"]))),
        "EOR_PLUS1": sf(ce_map.get(strike_key(strike_map["EOR_PLUS1"]))),
        "EOR": sf(ce_map.get(strike_key(strike_map["EOR"]))),
        "EOS": sf(pe_map.get(strike_key(strike_map["EOS"]))),
        "EOS_MINUS1": sf(pe_map.get(strike_key(strike_map["EOS_MINUS1"]))),
        "S_MaxPain": sf(pe_map.get(strike_key(strike_map["S_MaxPain"]))),
    }
    # NSE sometimes omits IV/Greeks for a deep adjacent strike, leaving the
    # local Black-Scholes map empty even though the website continues its live
    # six-line ladder.  Preserve the observed one-strike spacing as an explicit
    # local estimate; never use this fallback for the conditional AI-LTP fields.
    estimated: List[str] = []
    if values["EOR"] > 0:
        for key in ("EOR_PLUS1", "R_MaxPain"):
            if values[key] <= 0:
                values[key] = values["EOR"] + sf(strike_map[key]) - sf(strike_map["EOR"])
                estimated.append(key)
    if values["EOS"] > 0:
        for key in ("EOS_MINUS1", "S_MaxPain"):
            if values[key] <= 0:
                values[key] = values["EOS"] + sf(strike_map[key]) - sf(strike_map["EOS"])
                estimated.append(key)
    # A valid six-line ladder must remain ordered. A pathological quadratic
    # root or incomplete Greek pair must not silently export an outer line on
    # the wrong side of its base line.
    order_repairs: List[str] = []
    if values["EOR"] > 0 and values["EOR_PLUS1"] <= values["EOR"]:
        values["EOR_PLUS1"] = values["EOR"] + sf(strike_map["EOR_PLUS1"]) - sf(strike_map["EOR"])
        order_repairs.append("EOR_PLUS1")
    if values["EOR"] > 0 and values["R_MaxPain"] <= max(values["EOR"], values["EOR_PLUS1"]):
        values["R_MaxPain"] = values["EOR"] + sf(strike_map["R_MaxPain"]) - sf(strike_map["EOR"])
        order_repairs.append("R_MaxPain")
    if values["EOS"] > 0 and values["EOS_MINUS1"] >= values["EOS"]:
        values["EOS_MINUS1"] = values["EOS"] + sf(strike_map["EOS_MINUS1"]) - sf(strike_map["EOS"])
        order_repairs.append("EOS_MINUS1")
    if values["EOS"] > 0 and values["S_MaxPain"] >= min(values["EOS"], values["EOS_MINUS1"]):
        values["S_MaxPain"] = values["EOS"] + sf(strike_map["S_MaxPain"]) - sf(strike_map["EOS"])
        order_repairs.append("S_MaxPain")
    return values, {
        "mapping": "SELECTED_EOR_PLUS2_AND_EOS_MINUS2_STRIKE_ANCHORS",
        "res_base": res, "sup_base": sup,
        "eor_match_index": r_idx, "eos_match_index": s_idx,
        "eor_match_strike": ordered[r_idx] if ordered else res,
        "eos_match_strike": ordered[s_idx] if ordered else sup,
        "strike_map": strike_map,
        "adjacent_spacing_estimates": estimated,
        "order_repairs": order_repairs,
    }


_JS_PARSE_FLOAT = re.compile(r"^[\t\n\r ]*([+-]?(?:(?:\d+\.?\d*)|(?:\.\d+))(?:[eE][+-]?\d+)?)")


def _js_parse_float(value: Any) -> Optional[float]:
    """Match JavaScript parseFloat closely enough for website line inputs."""
    if isinstance(value, bool) or value is None:
        return None
    if isinstance(value, (int, float)):
        out = float(value)
        return out if math.isfinite(out) else None
    match = _JS_PARSE_FLOAT.match(str(value))
    if not match:
        return None
    try:
        out = float(match.group(1))
        return out if math.isfinite(out) else None
    except Exception:
        return None


def website_reversal_display(side: str, spot: Any, value: Any) -> Any:
    """Return the same number/status shape consumed by the website chart."""
    v, sp = sf(value), sf(spot)
    if v <= 0:
        return "NA"
    if str(side).upper() == "CE" and sp > v:
        return "Break Out"
    if str(side).upper() == "PE" and sp < v:
        return "Break Down"
    return v


def infer_reversal_model_scenario(ladder: Mapping[str, Any], spot: Any, step: Any) -> int:
    """Infer the backend AI-LTP scenario from calculated chain geometry.

    This is intentionally separate from COA 1.0: the website's reversalModel
    scenario is not the static support/resistance 3x3 COA matrix. Rules below
    were replayed against 469 timestamp-aligned option-chain snapshots.
    """
    r, s = (ladder.get("R") or {}), (ladder.get("S") or {})
    r_source = str(r.get("selected_source") or "").upper()
    s_source = str(s.get("selected_source") or "").upper()
    r_state = str(r.get("trade_status") or "").upper()
    s_state = str(s.get("trade_status") or "").upper()
    sp, st = sf(spot), sf(step) or 50.0
    r_vol_shift = sf((r.get("vol") or {}).get("shifting_strike"))
    r_base = sf(r.get("strike"))

    if r_source == "BOTH" and s_source == "VOLUME" and r_state == "STRONG" and s_state == "WTB":
        return 4
    if (
        r_source == "VOLUME" and r_state == "WTT"
        and ((s_state == "WTB" and s_source == "VOLUME") or (s_state == "STRONG" and s_source == "BOTH"))
    ):
        return 6
    if r_source == "BOTH" and s_source == "VOLUME" and r_state == "WTB" and s_state == "WTB":
        # The same BOTH/VOLUME transition becomes Scenario 8 only in the last
        # 12% below a strike boundary; otherwise replay labels it Scenario 6.
        return 8 if (sp % st) / st >= 0.88 else 6
    if r_source == "VOLUME" and s_source == "VOLUME" and r_state == "WTT" and s_state == "STRONG":
        return 3
    if (
        r_source == "BOTH" and s_source in {"BOTH", "VOLUME"}
        and r_state == "WTB" and s_state == "WTT"
        and r_vol_shift > 0.0
        and (r_vol_shift <= sp - 0.48 * st or r_base > sp + 1.70 * st)
    ):
        return 7
    # September replay also classifies WTT resistance versus STRONG support
    # as Scenario 7 when OI and volume agree on the support leader.  July's
    # superficially similar Scenario-9 rows use VOLUME-only support, so the
    # source guard is essential.
    if r_state == "WTT" and s_state == "STRONG" and s_source == "BOTH":
        return 7
    # Newer replay adds a widely separated WTT/WTT Scenario-7 geometry absent
    # from the July corpus. Keep the distance guard so the July equal-leader
    # WTT/WTT Scenario-9 observations retain their original classification.
    if r_state == "WTT" and s_state == "WTT" and abs(r_base - sf(s.get("strike"))) >= 4.0 * st:
        return 7
    # Scenario 8 is the short-lived BOTH/VOLUME WTB transition immediately
    # below the next strike boundary. It occurred once in the replay corpus.
    if r_state == "WTT" and s_state == "STRONG" and r_source == "OI" and s_source == "OI":
        return 8
    if r_state == "WTT" and s_state == "WTB" and r_source == "OI" and s_source == "VOLUME":
        return 8
    return 9


def build_local_index_reversal_model(
    full_rows: Sequence[Mapping[str, Any]],
    spot: Any,
    step: Any,
    ce_map: Mapping[Any, Any],
    pe_map: Mapping[Any, Any],
    ladder: Mapping[str, Any],
) -> Tuple[Dict[str, Any], Dict[str, Any]]:
    """Reconstruct the website's eight index reversalModel fields.

    The public chart bundle only renders these server-supplied fields; it does
    not contain the proprietary calculation. This fallback follows the WTT,
    WTB and STRONG strike selections observed in live and historical playback.
    A caller-supplied/native reversalModel remains authoritative.
    """
    sp, st = sf(spot), sf(step)
    r, s = (ladder.get("R") or {}), (ladder.get("S") or {})
    fallback = nearest_strike(full_rows, sp)
    r_base = nearest_strike(full_rows, r.get("strike")) if sf(r.get("strike")) > 0 else fallback
    s_base = nearest_strike(full_rows, s.get("strike")) if sf(s.get("strike")) > 0 else fallback
    r_shift = nearest_strike(full_rows, r.get("shifting_strike")) if sf(r.get("shifting_strike")) > 0 else r_base
    r_state = str(r.get("trade_status") or "STRONG").upper()
    r_source = str(r.get("selected_source") or "").upper()
    s_source = str(s.get("selected_source") or "").upper()
    has_component_geometry = any(
        isinstance(side.get(component), Mapping) and sf((side.get(component) or {}).get("strike")) > 0.0
        for side in (r, s) for component in ("oi", "vol")
    )
    scenario_number = infer_reversal_model_scenario(ladder, sp, st) if has_component_geometry else 0

    def strike(offset_base: Any, offset_steps: int) -> Any:
        return nearest_strike(full_rows, sf(offset_base) + offset_steps * st)

    def display(side: str, selected_strike: Any) -> Any:
        source = ce_map if side == "CE" else pe_map
        return website_reversal_display(side, sp, source.get(strike_key(selected_strike)))

    positive_r_anchors = [
        sf(value) for value in (
            r_base,
            (r.get("oi") or {}).get("shifting_strike"),
            (r.get("vol") or {}).get("shifting_strike"),
        ) if sf(value) > 0
    ]
    risky_anchor = nearest_strike(full_rows, min(positive_r_anchors)) if positive_r_anchors else r_base
    r_oi_leader = sf((r.get("oi") or {}).get("strike")) or sf(r_base)
    r_vol_leader = sf((r.get("vol") or {}).get("strike")) or sf(r_base)
    s_oi_leader = sf((s.get("oi") or {}).get("strike")) or sf(s_base)
    s_vol_leader = sf((s.get("vol") or {}).get("strike")) or sf(s_base)
    moderate_r_anchor = nearest_strike(full_rows, (r_oi_leader + r_vol_leader) / 2.0)
    moderate_s_anchor = (
        s_base if s_source == "OI"
        else nearest_strike(full_rows, (s_oi_leader + s_vol_leader) / 2.0)
    )
    s_shift = sf(s.get("shifting_strike"))
    shared_target_anchor = nearest_strike(full_rows, max(sf(risky_anchor), sf(s_base), s_shift))
    if s_shift > sf(s_base):
        moderate_s_anchor = s_base
    historical_both_volume_bearish = (
        r_state == "STRONG" and r_source == "BOTH" and s_source == "VOLUME"
        and sf(r_shift) < sf(r_base)
    )

    # The eight AI-LTP fields are a scenario-specific selection of already
    # calculated S-Reversal cells. These rules were reconstructed from 469
    # timestamp-aligned website snapshots; they do not fetch website values.
    if scenario_number == 3:
        # Scenario 3 selects the volume leaders on both sides. Resistance
        # Risky is one strike above the CE-volume leader, Max Pain is the OI
        # shift, and the support quartet walks down from the PE-volume leader.
        selections = {
            "riskyResistance": ("CE", strike(r_vol_leader, 1)),
            "moderateResistance": (None, None),
            "resistanceSL": ("CE", (r.get("oi") or {}).get("shifting_strike") or r_shift),
            "resistanceTarget": ("PE", s_vol_leader),
            "riskySupport": ("PE", s_vol_leader),
            "moderateSupport": ("PE", strike(s_vol_leader, -1)),
            "supportSL": ("PE", strike(s_vol_leader, -2)),
            "supportTarget": ("CE", r_vol_leader),
        }
    elif scenario_number == 4:
        # Scenario 4 is an interval rule, not a fixed offset table.  The
        # support side spans from the selected support leader to its downward
        # shift.  Risky Support is the inward midpoint (ties stay at the
        # leader), while Max Pain is the shift itself.  This produces the
        # observed July -1/-2 geometry and the September 0/-1 geometry.
        scenario4_support_shift = (
            nearest_strike(full_rows, s_shift)
            if s_shift > 0.0 and s_shift < sf(s_base)
            else strike(s_base, -2)
        )
        scenario4_gap_steps = max(0, int(round((sf(s_base) - sf(scenario4_support_shift)) / st)))
        scenario4_risky_support = strike(s_base, -(scenario4_gap_steps // 2))
        selections = {
            "riskyResistance": ("CE", r_base),
            "moderateResistance": ("CE", strike(r_base, 1)),
            "resistanceSL": ("CE", strike(r_base, 2)),
            "resistanceTarget": ("PE", s_base),
            "riskySupport": ("PE", scenario4_risky_support),
            "moderateSupport": (None, None),
            "supportSL": ("PE", scenario4_support_shift),
            "supportTarget": ("CE", r_base),
        }
    elif scenario_number == 6:
        if r_source == "BOTH" and s_source == "VOLUME":
            selections = {
                "riskyResistance": ("CE", r_shift),
                "moderateResistance": ("CE", r_base),
                "resistanceSL": (None, None),
                "resistanceTarget": ("PE", s_base),
                "riskySupport": (None, None), "moderateSupport": (None, None),
                "supportSL": (None, None), "supportTarget": (None, None),
            }
        else:
            selections = {
                "riskyResistance": ("CE", strike(r_base, -1)),
                # Scenario 6 deliberately repeats the same resistance cell for
                # risky and moderate labels. Around the open that cell can be the
                # website's displayed "Break Out" state while Max Pain remains at
                # base+2.
                "moderateResistance": ("CE", r_base),
                "resistanceSL": ("CE", strike(r_base, 2)),
                "resistanceTarget": ("PE", r_base),
                "riskySupport": (None, None), "moderateSupport": (None, None),
                "supportSL": (None, None), "supportTarget": (None, None),
            }
    elif scenario_number == 7:
        # Risky Support follows the real upward support shift when present;
        # it is only one strike above the leader when no farther shift exists.
        # Max Gain is the CE reversal at the resistance leader.  The previous
        # S+1/S+2 constants happened to match July because R was S+2 there,
        # but failed when September replay separated the two leaders.
        scenario7_risky_support = (
            nearest_strike(full_rows, s_shift)
            if s_shift > sf(s_base)
            else strike(s_base, 1)
        )
        selections = {
            "riskyResistance": (None, None), "moderateResistance": (None, None),
            "resistanceSL": (None, None), "resistanceTarget": (None, None),
            "riskySupport": ("PE", scenario7_risky_support),
            "moderateSupport": ("PE", s_base),
            "supportSL": ("PE", strike(s_base, -2)),
            "supportTarget": ("CE", r_base),
        }
    elif scenario_number == 8:
        # Scenario-8 resistance pair is anchored to the actual volume-shift
        # strike, not to fixed R offsets. Historical NIFTY observations cover
        # shifts at R+2 and R+4: Risky is one listed strike below the shift,
        # while Max Pain is the shift cell itself. An independent ADANIPORTS
        # observation confirms the R+2/shift-minus-one construction.
        scenario8_r_shift = (
            nearest_strike(full_rows, sf((r.get("vol") or {}).get("shifting_strike")))
            if sf((r.get("vol") or {}).get("shifting_strike")) > sf(r_base)
            else strike(r_base, 2)
        )
        selections = {
            "riskyResistance": ("CE", strike(scenario8_r_shift, -1)),
            "moderateResistance": (None, None),
            "resistanceSL": ("CE", scenario8_r_shift),
            "resistanceTarget": ("PE", s_base),
            "riskySupport": ("PE", strike(s_base, -1)),
            "moderateSupport": (None, None),
            "supportSL": ("PE", strike(s_base, -2)),
            "supportTarget": ("CE", strike(s_base, 2)),
        }
    elif scenario_number == 9:
        selections = {
            "riskyResistance": ("CE", risky_anchor),
            # Moderate anchors are the nearest listed strike to the midpoint
            # of the independently calculated OI and volume leaders.
            "moderateResistance": ("CE", moderate_r_anchor),
            "resistanceSL": ("CE", strike(r_base, 2)),
            "resistanceTarget": ("PE", shared_target_anchor),
            "riskySupport": ("PE", shared_target_anchor),
            "moderateSupport": ("PE", moderate_s_anchor),
            "supportSL": ("PE", strike(s_base, -2)),
            "supportTarget": ("CE", risky_anchor),
        }
    # Historical website parity, NIFTY 24-Jul-2025 12:06:00:
    # CE OI+volume selected BOTH at r_base, with the secondary pressure at the
    # lower r_shift; PE selected VOLUME.  The website places Risky at r_shift,
    # Moderate at r_base, Max Pain two strikes above r_base and suppresses the
    # support quartet for this one-sided bearish condition.  Treating generic
    # STRONG as r_base/r_base+1 shifted the first two lines one strike upward.
    elif historical_both_volume_bearish:
        selections = {
            "riskyResistance": ("CE", r_shift),
            "moderateResistance": ("CE", r_base),
            "resistanceSL": ("CE", strike(r_base, 2)),
            "resistanceTarget": ("PE", s_base),
            "riskySupport": (None, None),
            "moderateSupport": (None, None),
            "supportSL": (None, None),
            "supportTarget": (None, None),
        }
    elif r_state == "WTT":
        selections = {
            "riskyResistance": (None, None),
            "moderateResistance": (None, None),
            "resistanceSL": (None, None),
            "resistanceTarget": (None, None),
            "riskySupport": ("PE", s_base),
            "moderateSupport": ("PE", strike(s_base, -1)),
            "supportSL": ("PE", strike(s_base, -2)),
            "supportTarget": ("CE", r_shift if sf(r_shift) > sf(r_base) else strike(r_base, 1)),
        }
    elif r_state == "WTB":
        selections = {
            "riskyResistance": ("CE", r_shift),
            "moderateResistance": ("CE", r_base),
            # Website 24-Jul-2025 09:21: WTB Max Pain is one strike above
            # the main resistance (equivalently two above the lower shift).
            "resistanceSL": ("CE", strike(r_base, 1)),
            # The website's resistance-side Max Gain overlays the live EOS
            # level.  It comes from the PE reversal at the support anchor,
            # not from the shifted resistance strike.  Using r_shift turns a
            # valid value into "Break Down" and was the cause of the missing
            # line reported on 10-Sep-2026.
            "resistanceTarget": ("PE", s_base),
            "riskySupport": ("PE", strike(s_base, -1)),
            "moderateSupport": (None, None),
            "supportSL": ("PE", strike(s_base, -2)),
            "supportTarget": ("CE", s_base),
        }
    else:
        selections = {
            "riskyResistance": ("CE", r_base),
            "moderateResistance": ("CE", strike(r_base, 1)),
            "resistanceSL": ("CE", strike(r_base, 2)),
            "resistanceTarget": ("PE", s_base),
            "riskySupport": ("PE", strike(s_base, -1)),
            "moderateSupport": (None, None),
            "supportSL": ("PE", strike(s_base, -2)),
            "supportTarget": ("CE", s_base),
        }

    model = {
        field: "NA" if side is None else display(side, source_strike)
        for field, (side, source_strike) in selections.items()
    }
    return model, {
        "source": "LOCAL_CONDITIONAL_RECONSTRUCTION",
        "exact_website_parity": False,
        "condition": "STRONG_BOTH_VOLUME_BEARISH" if historical_both_volume_bearish else r_state,
        "scenario_number": scenario_number,
        "risky_anchor": risky_anchor,
        "resistance_strike": r_base,
        "resistance_shifting_strike": r_shift,
        "support_strike": s_base,
        "source_strikes": {
            field: source_strike for field, (_, source_strike) in selections.items()
        },
        "important_limit": "The website backend supplies reversalModel; its proprietary formula is not present in the public chart bundle.",
    }


def apply_website_plot_carry_forward(
    descriptors: Sequence[Mapping[str, Any]],
    previous_numeric: Optional[Mapping[str, Any]] = None,
) -> Tuple[List[Dict[str, Any]], Dict[str, float]]:
    """Mirror the site's numeric/grey carry-forward rule for price lines."""
    last = {
        str(key): float(value)
        for key, value in (previous_numeric or {}).items()
        if _js_parse_float(value) is not None
    }
    plotted: List[Dict[str, Any]] = []
    for descriptor in descriptors:
        key = str(descriptor.get("key") or descriptor.get("title") or "")
        raw = descriptor.get("raw")
        numeric = _js_parse_float(raw)
        is_current_numeric = numeric is not None
        if is_current_numeric:
            last[key] = float(numeric)
        price = float(numeric) if is_current_numeric else last.get(key)
        plotted.append({
            **dict(descriptor),
            "raw": raw,
            "price": price,
            "color": descriptor.get("base_color") if is_current_numeric else "gray",
            "current_numeric": is_current_numeric,
            "carried_forward": (not is_current_numeric and price is not None),
            "visible": price is not None and math.isfinite(price),
        })
    return plotted, last


def website_d_overlays(
    full_rows: Sequence[Mapping[str, Any]],
    spot: Any,
    ce_map: Mapping[Any, Any],
    pe_map: Mapping[Any, Any],
) -> Tuple[List[Dict[str, Any]], Dict[str, Any]]:
    """Exact website D1/D2/D3 eight-row slice and breakdown branch."""
    rows = sorted(list(full_rows), key=lambda row: sf(row.get("strikePrice")))
    sp = sf(spot)
    su = next((idx for idx, row in enumerate(rows) if sf(row.get("strikePrice")) >= sp), -1)
    if su < 0:
        return [], {"status": "NO_STRIKE_AT_OR_ABOVE_SPOT", "su": su}
    # JavaScript Array.slice(su-4, su+4), including negative-index semantics.
    n = len(rows)
    start_raw, end_raw = su - 4, su + 4
    start = max(n + start_raw, 0) if start_raw < 0 else min(start_raw, n)
    end = max(n + end_raw, 0) if end_raw < 0 else min(end_raw, n)
    window = rows[start:max(start, end)]
    if len(window) < 7:
        return [], {"status": "INSUFFICIENT_EIGHT_ROW_WINDOW", "su": su, "slice_start": start, "slice_size": len(window)}

    def raw(index: int, side: str) -> Any:
        strike = sf(window[index].get("strikePrice"))
        source = ce_map if side == "CE" else pe_map
        return website_reversal_display(side, sp, source.get(strike_key(strike)))

    pivot_put = raw(4, "PE")
    shifted = str(pivot_put) in {"Break Down", "NA"}
    indices = {
        "D1_CALL": 3 if shifted else 4, "D1_PUT": 3 if shifted else 4,
        "D2_CALL": 4 if shifted else 5, "D2_PUT": 2 if shifted else 3,
        "D3_CALL": 5 if shifted else 6, "D3_PUT": 1 if shifted else 2,
    }
    colors = {
        "D1_CALL": "blue", "D1_PUT": "purple",
        "D2_CALL": "orange", "D2_PUT": "brown",
        "D3_CALL": "cyan", "D3_PUT": "violet",
    }
    descriptors = []
    for key in ("D1_CALL", "D1_PUT", "D2_CALL", "D2_PUT", "D3_CALL", "D3_PUT"):
        side = "CE" if key.endswith("CALL") else "PE"
        idx = indices[key]
        descriptors.append({
            "key": key,
            "title": key.replace("_", " ").title(),
            "base_color": colors[key],
            "line_style": "dotted",
            "raw": raw(idx, side),
            "source_strike": sf(window[idx].get("strikePrice")),
        })
    return descriptors, {
        "status": "OK", "su": su, "slice_start": start,
        "pivot_put": pivot_put, "breakdown_shifted": shifted,
        "source_indices": indices,
    }


def website_reversal_model_descriptors(reversal_model: Optional[Mapping[str, Any]]) -> List[Dict[str, Any]]:
    """Map the website's eight reversalModel fields to chart descriptors."""
    model = reversal_model or {}
    specs = (
        ("R_RISKY", "R Risky", "riskyResistance", "red"),
        ("R_MODERATE", "R Moderate", "moderateResistance", "red"),
        ("R_MAX_PAIN", "R Max Pain", "resistanceSL", "red"),
        ("R_MAX_GAIN", "R Max Gain", "resistanceTarget", "red"),
        ("S_RISKY", "S Risky", "riskySupport", "green"),
        ("S_MODERATE", "S Moderate", "moderateSupport", "green"),
        ("S_MAX_PAIN", "S Max Pain", "supportSL", "green"),
        ("S_MAX_GAIN", "S Max Gain", "supportTarget", "green"),
    )
    return [
        {
            "key": key, "title": title, "raw": model.get(field, "NA"),
            "base_color": color, "source_field": field,
            "line_style": "dashed" if key in {"R_MAX_PAIN", "R_MAX_GAIN", "S_MAX_PAIN", "S_MAX_GAIN"} else "solid",
        }
        for key, title, field, color in specs
    ]


def build_website_plotting(
    full_rows: Sequence[Mapping[str, Any]],
    spot: Any,
    ce_map: Mapping[Any, Any],
    pe_map: Mapping[Any, Any],
    magical_lines: Mapping[str, Any],
    magical_mapping: Mapping[str, Any],
    state_key: Optional[str] = None,
    reversal_model: Optional[Mapping[str, Any]] = None,
    instrument_kind: str = "INDEX",
    stock_entry_lines: Optional[Mapping[str, Any]] = None,
) -> Dict[str, Any]:
    """Build the website's complete refresh-to-refresh plotting state."""
    kind = str(instrument_kind or "INDEX").upper()
    cache_key = str(state_key or "").strip()
    previous = dict(_WEBSITE_PLOT_LAST_NUMERIC.get(cache_key, {})) if cache_key else {}
    if kind == "EQUITY":
        ai_descriptors = website_reversal_model_descriptors(reversal_model)
        stock_descriptors = [
            dict(item) for item in (stock_entry_lines or {}).get("lines", ())
        ]
        ai_series, last = apply_website_plot_carry_forward(ai_descriptors, previous)
        stock_series, last = apply_website_plot_carry_forward(stock_descriptors, last)
        live_series = []
        series = ai_series + stock_series
        d_series, d_debug = [], {"status": "NOT_APPLICABLE_TO_EQUITY"}
        branch = "EQUITY_REVERSAL_MODEL_PLUS_NATIVE_C1_C2_P1_P2"
    else:
        values = magical_lines
        ai_descriptors = website_reversal_model_descriptors(reversal_model)
        # The website exposes Live and AI-LTP as independent toggles.  Use
        # distinct internal keys even when their current prices overlap.
        live_descriptors = [
            {"key": "LIVE_R_MAX_PAIN", "export_key": "R_MaxPain", "title": "Max Pain", "raw": website_reversal_display("CE", spot, values.get("R_MaxPain")), "base_color": "red"},
            {"key": "LIVE_EOR_PLUS1", "export_key": "EOR_PLUS1", "title": "EOR+1", "raw": website_reversal_display("CE", spot, values.get("EOR_PLUS1")), "base_color": "red"},
            {"key": "LIVE_EOR", "export_key": "EOR", "title": "EOR", "raw": website_reversal_display("CE", spot, values.get("EOR")), "base_color": "red"},
            {"key": "LIVE_EOS", "export_key": "EOS", "title": "EOS", "raw": website_reversal_display("PE", spot, values.get("EOS")), "base_color": "green"},
            {"key": "LIVE_EOS_MINUS1", "export_key": "EOS_MINUS1", "title": "EOS-1", "raw": website_reversal_display("PE", spot, values.get("EOS_MINUS1")), "base_color": "green"},
            {"key": "LIVE_S_MAX_PAIN", "export_key": "S_MaxPain", "title": "Max Pain", "raw": website_reversal_display("PE", spot, values.get("S_MaxPain")), "base_color": "green"},
        ]
        ai_series, last = apply_website_plot_carry_forward(ai_descriptors, previous)
        live_series, last = apply_website_plot_carry_forward(live_descriptors, last)
        stock_series = []
        series = ai_series + live_series
        d_descriptors, d_debug = website_d_overlays(full_rows, spot, ce_map, pe_map)
        d_series, last = apply_website_plot_carry_forward(d_descriptors, last)
        branch = "INDEX_SEPARATE_AI_LTP_LIVE_SIX_AND_D_OVERLAYS"
    if cache_key:
        _WEBSITE_PLOT_LAST_NUMERIC[cache_key] = dict(last)
    return {
        "formula_lock": CANONICAL_ENGINE_VERSION,
        "certification_status": AI_LTP_PARITY_CERTIFICATION["status"],
        "certification": dict(AI_LTP_PARITY_CERTIFICATION),
        "warning": "Plot mapping is implemented; local reversal values are not website-exact.",
        "branch": branch,
        "state_key": cache_key,
        "series": series,
        "families": {
            "ai_ltp": ai_series,
            "live": live_series,
            "stock": stock_series,
            "d_overlays": d_series,
        },
        "d_overlays": d_series,
        "d_overlay_debug": d_debug,
        "last_numeric": last,
        "raw_magical_mapping": dict(magical_mapping),
        "website_asset": VERIFICATION_PROVENANCE["website_asset"],
        "website_asset_sha256": VERIFICATION_PROVENANCE["website_asset_sha256"],
    }


def magical_tv_export(
    values: Mapping[str, Any],
    website_plotting: Optional[Mapping[str, Any]] = None,
) -> str:
    """Export only magical levels that are currently numeric on the website.

    ``values`` is retained as a backwards-compatible fallback for callers that
    do not build the website plotting state.  The live bundle always supplies
    ``website_plotting`` so Break Out, Break Down and NA levels cannot leak into
    TradingView as apparently-active lines.  Carried-forward grey website lines
    are intentionally omitted because the text export cannot encode stale/grey
    state and Pine would otherwise draw them as current levels.
    """
    if website_plotting is None:
        parts = []
        for key in MAGICAL_TV_EXPORT_KEYS:
            value = sf(values.get(key))
            if value > 0 and math.isfinite(value):
                parts.append(f"{key}={value:.2f}")
        return " | ".join(parts)

    current: Dict[str, float] = {}
    for descriptor in website_plotting.get("series", ()):
        if not descriptor.get("current_numeric"):
            continue
        export_key = WEBSITE_PLOT_KEY_TO_MAGICAL_EXPORT_KEY.get(str(descriptor.get("key") or ""))
        if export_key is None:
            continue
        numeric = _js_parse_float(descriptor.get("price"))
        if numeric is not None and numeric > 0:
            current[export_key] = float(numeric)

    return " | ".join(
        f"{key}={current[key]:.2f}"
        for key in MAGICAL_TV_EXPORT_KEYS
        if key in current
    )


def calculated_magical_tv_export(values: Mapping[str, Any]) -> str:
