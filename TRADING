def parsed_market_timestamp(row: Mapping[str, Any]) -> datetime:
    """Parse the snapshot's exchange/log time for reproducible historical Greeks."""
    text = str(row.get("nse_ts") or row.get("log_ts") or "").strip()
    for fmt in ("%d-%b-%Y %H:%M:%S", "%Y-%m-%d %H:%M:%S", "%d/%m/%Y %H:%M:%S"):
        try:
            return datetime.strptime(text, fmt)
        except ValueError:
            pass
    return datetime.min


def latest_snapshot_rows(rows: Sequence[Mapping[str, Any]]) -> List[Mapping[str, Any]]:
    """Select only the newest timestamp from an append-only FULLCHAIN CSV."""
    if not rows:
        return []

    newest = max(parsed_market_timestamp(row) for row in rows)
    selected = [row for row in rows if parsed_market_timestamp(row) == newest]
    # Multiple fetcher instances can append the same timestamp twice. The
    # latest copy of each strike is sufficient and matches the live snapshot.
    deduped: Dict[Any, Mapping[str, Any]] = {}
    for row in selected:
        deduped[strike_key(row.get("strike") or row.get("strikePrice"))] = row
    return [deduped[key] for key in sorted(deduped, key=sf)]


def _row_map(full_rows: Sequence[Mapping[str, Any]]) -> Dict[Any, Mapping[str, Any]]:
    return {strike_key(r.get("strikePrice")): r for r in full_rows}


def nearest_strike(full_rows: Sequence[Mapping[str, Any]], strike: Any) -> Any:
    strikes = [strike_key(r.get("strikePrice")) for r in full_rows]
    return min(strikes, key=lambda k: abs(sf(k) - sf(strike))) if strikes else strike_key(strike)


def _opt(row: Mapping[str, Any], side: str, field: str) -> float:
    return sf((row.get(side, {}) or {}).get(field))


# ---- Refresh-to-refresh all-strike writer migration -----------------------
def _migration_snapshot(full_rows: Sequence[Mapping[str, Any]]) -> Dict[Tuple[Any, str], Dict[str, float]]:
    out: Dict[Tuple[Any, str], Dict[str, float]] = {}
    for row in full_rows:
        strike = strike_key(row.get("strikePrice"))
        if sf(strike) <= 0:
            continue
        for side in ("CE", "PE"):
            out[(strike, side)] = {
                "oi": max(0.0, _opt(row, side, "openInterest")),
                "volume": max(0.0, _opt(row, side, "totalTradedVolume")),
                "ltp": max(0.0, _opt(row, side, "lastPrice")),
            }
    return out


def _pair_writer_migrations(events: Sequence[Mapping[str, Any]], side: str) -> List[Dict[str, Any]]:
    """Pair likely writer exits with likely new writing; this is an inference."""
    sources = [
        [sf(e.get("strike")), max(0.0, -sf(e.get("oi_delta")))]
        for e in events if e.get("side") == side and e.get("state") == "SHORT_COVERING"
    ]
    destinations = [
        [sf(e.get("strike")), max(0.0, sf(e.get("oi_delta")))]
        for e in events if e.get("side") == side and e.get("state") == "SHORT_BUILDUP"
    ]
    sources.sort(key=lambda item: item[1], reverse=True)
    destinations.sort(key=lambda item: item[1], reverse=True)
    pairs: List[Dict[str, Any]] = []
    for source in sources:
        remaining = source[1]
        for destination in destinations:
            if remaining <= 0:
                break
            if destination[1] <= 0 or destination[0] == source[0]:
                continue
            moved = min(remaining, destination[1])
            if moved <= 0:
                continue
            pairs.append({
                "side": side,
                "from_strike": strike_key(source[0]),
                "to_strike": strike_key(destination[0]),
                "inferred_oi_moved": round(moved, 2),
                "direction": "UP_STRIKE" if destination[0] > source[0] else "DOWN_STRIKE",
                "note": "Inferred from simultaneous short-covering and short-buildup; participant identity is unknowable.",
            })
            remaining -= moved
            destination[1] -= moved
    return pairs


class WriterMigrationTracker:
    """Maintain per-strike OI/volume/LTP state across live refreshes."""

    def __init__(self, window_steps: int = 10, history_limit: int = 30) -> None:
        self.window_steps = max(1, int(window_steps))
        self.history_limit = max(3, int(history_limit))
        self.previous: Dict[Tuple[Any, str], Dict[str, float]] = {}
        self.previous_id = ""
        self.last_result: Dict[str, Any] = {}
        self.history: List[Dict[str, Any]] = []

    def update(
        self,
        full_rows: Sequence[Mapping[str, Any]],
        spot: Any,
        step: Any,
        atm: Any = None,
        snapshot_id: Any = None,
    ) -> Dict[str, Any]:
        current = _migration_snapshot(full_rows)
        sp = sf(spot)
        st = sf(step) or calc_strike_gap(k[0] for k in current) or 1.0
        at = sf(atm) or (min((sf(k[0]) for k in current), key=lambda k: abs(k - sp)) if current else sp)
        sid = str(snapshot_id or datetime.now().isoformat(timespec="seconds"))
        if sid and sid == self.previous_id and self.last_result:
            return dict(self.last_result)

        base = {
            "migration_version": WRITER_MIGRATION_VERSION,
            "snapshot_id": sid,
            "spot": sp,
            "atm": at,
            "step": st,
            "window_steps": self.window_steps,
            "all_strikes_reviewed": len({k[0] for k in current}),
            "decision_window": [strike_key(at - self.window_steps * st), strike_key(at + self.window_steps * st)],
        }
        if not self.previous:
            self.previous, self.previous_id = current, sid
            self.last_result = {
                **base, "status": "WARMING_UP", "direction_bias": "INSUFFICIENT_HISTORY",
                "direction_score": 0.0, "confidence_pct": 0.0,
                "support_strike": 0.0, "resistance_strike": 0.0,
                "target_zone_low": 0.0, "target_zone_high": 0.0,
                "pressure_from": 0.0, "pressure_to": 0.0,
                "strike_deltas": [], "migrations": [],
                "summary": "First snapshot stored; next distinct refresh will calculate migration.",
            }
            return dict(self.last_result)

        events: List[Dict[str, Any]] = []
        common_keys = sorted(set(current).intersection(self.previous), key=lambda key: (sf(key[0]), key[1]))
        for strike, side in common_keys:
            cur, prev = current[(strike, side)], self.previous[(strike, side)]
            doi = cur["oi"] - prev["oi"]
            dvol = cur["volume"] - prev["volume"] if cur["volume"] >= prev["volume"] else cur["volume"]
            dltp = cur["ltp"] - prev["ltp"]
            if doi > 0 and dltp <= 0:
                state = "SHORT_BUILDUP"
            elif doi < 0 and dltp >= 0:
                state = "SHORT_COVERING"
            elif doi > 0 and dltp > 0:
                state = "LONG_BUILDUP"
            elif doi < 0 and dltp < 0:
                state = "LONG_UNWINDING"
            else:
                state = "UNCHANGED"
            events.append({
                "strike": strike_key(strike), "side": side,
                "oi": round(cur["oi"], 2), "oi_delta": round(doi, 2),
                "volume": round(cur["volume"], 2), "volume_delta": round(max(0.0, dvol), 2),
                "ltp": round(cur["ltp"], 2), "ltp_delta": round(dltp, 2),
                "state": state,
                "in_atm_window": abs(sf(strike) - at) <= self.window_steps * st + 1e-9,
            })

        focus = [e for e in events if e["in_atm_window"]]
        max_oi_delta = max((abs(sf(e["oi_delta"])) for e in focus), default=0.0) or 1.0
        max_vol_delta = max((sf(e["volume_delta"]) for e in focus), default=0.0) or 1.0
        bull = bear = 0.0
        for event in focus:
            dist_steps = abs(sf(event["strike"]) - at) / st if st else 0.0
            proximity = 1.0 / (1.0 + dist_steps / 4.0)
            magnitude = 0.70 * abs(sf(event["oi_delta"])) / max_oi_delta + 0.30 * sf(event["volume_delta"]) / max_vol_delta
            event["pressure_weight"] = round(magnitude * proximity, 6)
            state, side = event["state"], event["side"]
            weight = sf(event["pressure_weight"])
            if (side == "PE" and state == "SHORT_BUILDUP") or (side == "CE" and state == "SHORT_COVERING"):
                bull += weight
            elif (side == "CE" and state == "SHORT_BUILDUP") or (side == "PE" and state == "SHORT_COVERING"):
                bear += weight

        total = bull + bear
        score = (bull - bear) / total * 100.0 if total > 0 else 0.0
        if score >= 15.0:
            bias = "UP_PRESSURE"
        elif score <= -15.0:
            bias = "DOWN_PRESSURE"
        else:
            bias = "RANGE_OR_MIXED"

        migrations = _pair_writer_migrations(events, "CE") + _pair_writer_migrations(events, "PE")
        migrations.sort(key=lambda item: sf(item.get("inferred_oi_moved")), reverse=True)
        pe_writing = [e for e in focus if e["side"] == "PE" and e["state"] == "SHORT_BUILDUP"]
        ce_writing = [e for e in focus if e["side"] == "CE" and e["state"] == "SHORT_BUILDUP"]
        pe_current = [e for e in focus if e["side"] == "PE" and sf(e["strike"]) <= sp]
        ce_current = [e for e in focus if e["side"] == "CE" and sf(e["strike"]) >= sp]
        support_event = max(pe_writing or pe_current, key=lambda e: (sf(e.get("pressure_weight")), sf(e.get("oi"))), default={})
        resistance_event = max(ce_writing or ce_current, key=lambda e: (sf(e.get("pressure_weight")), sf(e.get("oi"))), default={})
        support = sf(support_event.get("strike"))
        resistance = sf(resistance_event.get("strike"))
        bull_events = [e for e in focus if (e["side"], e["state"]) in (("PE", "SHORT_BUILDUP"), ("CE", "SHORT_COVERING"))]
        bear_events = [e for e in focus if (e["side"], e["state"]) in (("CE", "SHORT_BUILDUP"), ("PE", "SHORT_COVERING"))]
        pressure_event = max(bull_events if bias == "UP_PRESSURE" else bear_events if bias == "DOWN_PRESSURE" else focus, key=lambda e: sf(e.get("pressure_weight")), default={})
        pressure_from = sf(pressure_event.get("strike"))
        if bias == "UP_PRESSURE":
            pressure_to = resistance if resistance > sp else at + st
        elif bias == "DOWN_PRESSURE":
            pressure_to = support if 0 < support < sp else at - st
        else:
            pressure_to = at
        half_zone = max(st * 0.25, 0.01)
        target_low, target_high = pressure_to - half_zone, pressure_to + half_zone

        recent_same = sum(1 for h in self.history[-3:] if h.get("direction_bias") == bias and bias != "RANGE_OR_MIXED")
        active_events = sum(1 for e in focus if e["state"] in ("SHORT_BUILDUP", "SHORT_COVERING"))
        confidence = min(95.0, (abs(score) * 0.65) + min(18.0, active_events * 1.5) + recent_same * 5.0)
        summary = (
            f"{bias} score={score:+.1f}, confidence={confidence:.1f}%; "
            f"writers inferred from {pressure_from:.0f} toward {pressure_to:.0f}; "
            f"support={support:.0f}, resistance={resistance:.0f}."
        )
        result = {
            **base, "status": "READY", "direction_bias": bias,
            "direction_score": round(score, 2), "confidence_pct": round(confidence, 2),
            "bull_pressure": round(bull, 6), "bear_pressure": round(bear, 6),
            "support_strike": strike_key(support) if support > 0 else 0.0,
            "resistance_strike": strike_key(resistance) if resistance > 0 else 0.0,
            "target_zone_low": round(target_low, 2), "target_zone_high": round(target_high, 2),
            "pressure_from": strike_key(pressure_from) if pressure_from > 0 else 0.0,
            "pressure_to": strike_key(pressure_to) if pressure_to > 0 else 0.0,
            "strike_deltas": events, "migrations": migrations,
            "summary": summary,
            "limitations": "Probabilistic inference only; simultaneous OI changes cannot prove the same writers moved between strikes.",
        }
        self.history.append({"snapshot_id": sid, "direction_bias": bias, "direction_score": score})
        if len(self.history) > self.history_limit:
            del self.history[:-self.history_limit]
        self.previous, self.previous_id, self.last_result = current, sid, result
        return dict(result)


_WRITER_MIGRATION_TRACKERS: Dict[str, WriterMigrationTracker] = {}


def update_writer_migration(
    tracker_key: Any,
    full_rows: Sequence[Mapping[str, Any]],
    spot: Any,
    step: Any,
    atm: Any = None,
    snapshot_id: Any = None,
    window_steps: int = WRITER_PRESSURE_WINDOW_STEPS,
) -> Dict[str, Any]:
    """Shared process-level tracker used by every production refresh route."""
    key = str(tracker_key or "DEFAULT")
    tracker = _WRITER_MIGRATION_TRACKERS.get(key)
    if tracker is None or tracker.window_steps != int(window_steps):
        tracker = WriterMigrationTracker(window_steps=window_steps)
        _WRITER_MIGRATION_TRACKERS[key] = tracker
    return tracker.update(full_rows, spot, step, atm, snapshot_id)


# ---- Exact V53 resistance/support anchor ladder ---------------------------
def _ltp_il(spot: Any, atm: Any, step: Any) -> float:
    st, at, sp = sf(step) or 50.0, sf(atm), sf(spot)
    if at > 0:
        return at
    grid = st * 2.0 if st < 100.0 else st
    return math.floor(sp / grid + 0.5) * grid if sp > 0 else 0.0


def _window_rows(full_rows: Sequence[Mapping[str, Any]], spot: Any, atm: Any, step: Any, width_steps: int) -> List[Mapping[str, Any]]:
    il, st = _ltp_il(spot, atm, step), sf(step) or calc_strike_gap(r.get("strikePrice") for r in full_rows) or 50.0
    selected = [r for r in full_rows if il - width_steps * st <= sf(r.get("strikePrice")) <= il + width_steps * st]
    return selected or list(full_rows)


def _component(full_rows: Sequence[Mapping[str, Any]], side: str, metric: str, spot: Any, atm: Any, step: Any, shift_width: int = LTP_ACTIVE_WINDOW_STEPS, shift_filter: Optional[str] = None) -> Dict[str, Any]:
    il, st = _ltp_il(spot, atm, step), sf(step)
    field = "openInterest" if metric == "OI" else "totalTradedVolume"

    def points(rows: Sequence[Mapping[str, Any]]) -> List[Dict[str, float]]:
        out = [{"strike": sf(r.get("strikePrice")), "value": max(0.0, _opt(r, side, field)), "dist": abs(sf(r.get("strikePrice")) - il)} for r in rows]
        return sorted([p for p in out if p["strike"] > 0 and p["value"] > 0], key=lambda p: (-p["value"], p["dist"]))

    leaders = points(_window_rows(full_rows, spot, atm, step, LTP_ACTIVE_WINDOW_STEPS))
    if not leaders:
        return {"metric": metric, "strike": 0.0, "value": 0.0, "status": "NONE", "shifting_strike": 0.0, "shifting_per": 0.0}
    leader, top = leaders[0], leaders[0]["value"]
    shifts = points(_window_rows(full_rows, spot, atm, step, shift_width))
    if shift_filter == "GE_ATM": shifts = [p for p in shifts if p["strike"] >= il]
    elif shift_filter == "GE_ATM_MINUS_STEP": shifts = [p for p in shifts if p["strike"] >= il - st]
    elif shift_filter == "LE_ATM": shifts = [p for p in shifts if p["strike"] <= il]
    others = [p for p in shifts if p["strike"] != leader["strike"]]
    others.sort(key=lambda p: (-(p["value"] / top if top else 0.0), p["dist"]))
    shift = others[0] if others else leader
    ratio = shift["value"] / top * 100.0 if top else 0.0
    status = "STRONG"
    if ratio >= PINK_THRESHOLD * 100.0 and shift["strike"] != leader["strike"]:
        status = "WTT" if shift["strike"] > leader["strike"] else "WTB"
    return {"metric": metric, "strike": leader["strike"], "value": top, "status": status, "shifting_strike": shift["strike"], "shifting_per": ratio}


def _calculated_side(full_rows: Sequence[Mapping[str, Any]], side: str, spot: Any, atm: Any, step: Any) -> Dict[str, Any]:
    il, st = _ltp_il(spot, atm, step), sf(step)
    if side == "CE":
        oi = _component(full_rows, side, "OI", spot, atm, step, shift_filter="GE_ATM")
        # Website replay parity: when the CE-volume leader is no lower than
        # ATM-1, its secondary pressure is ranked only from ATM-1 upward.
        # Removing this filter preserved the leader/status but changed the
        # displayed shifting percentage in 210 of 580 captured snapshots.
        vol_base = _component(full_rows, side, "VOLUME", spot, atm, step)
        vol_filter = "GE_ATM_MINUS_STEP" if sf(vol_base.get("strike")) >= il - st else None
        vol = _component(full_rows, side, "VOLUME", spot, atm, step, shift_filter=vol_filter)
    else:
        oi = _component(full_rows, side, "OI", spot, atm, step)
        vol = _component(full_rows, side, "VOLUME", spot, atm, step)
    # Historical BANKNIFTY contains occasional zero-Greek volume counters that
    # are more than 10x every neighbouring strike. The website discards that
    # isolated counter and promotes the next volume leader instead of changing
    # the side to OI. Ordinary zero-Greek opening prints (FINNIFTY Scenario 3)
    # remain eligible because they are not isolated magnitude outliers.
    active = _window_rows(full_rows, spot, atm, step, LTP_ACTIVE_WINDOW_STEPS)
    volume_rank = sorted(
        [(_opt(row, side, "totalTradedVolume"), sf(row.get("strikePrice")), row) for row in active],
        reverse=True,
    )
    if len(volume_rank) >= 2 and volume_rank[0][0] > 10.0 * max(volume_rank[1][0], 1.0):
        top_value, top_strike, top_row = volume_rank[0]
        top_valid = (
            _opt(top_row, side, "impliedVolatility") > 0.0
            or abs(_opt(top_row, side, "delta")) > 0.0
            or _opt(top_row, side, "gamma") > 0.0
        )
        if not top_valid:
            without_outlier = [row for row in full_rows if strike_key(row.get("strikePrice")) != strike_key(top_strike)]
            vol = _component(without_outlier, side, "VOLUME", spot, atm, step, shift_filter=vol_filter if side == "CE" else None)
    both = sf(oi.get("strike")) > 0 and abs(sf(oi.get("strike")) - sf(vol.get("strike"))) < 0.01
    source = "BOTH" if both else "VOLUME"
    # When OI is weak but volume is strong, the website uses the directional
    # OI component. Otherwise disagreement is resolved in favour of volume,
    # including legitimate zero-Greek opening prints.
    if not both:
        oi_state = str(oi.get("status") or "").upper()
        vol_state = str(vol.get("status") or "").upper()
        oi_weak, vol_weak = oi_state in {"WTT", "WTB"}, vol_state in {"WTT", "WTB"}
        if oi_weak and not vol_weak and sf(oi.get("strike")) > 0.0:
            source = "OI"
        elif oi_weak and vol_weak and sf(oi.get("shifting_per")) > sf(vol.get("shifting_per")):
            source = "OI"
    selected = oi if source in {"BOTH", "OI"} else vol
    if source == "BOTH":
        # At a common OI/volume leader the website's final WTT/WTB/STRONG
        # state follows the volume component. OI remains visible as supporting
        # context but does not override the final side status.
        selected = vol
        trade_status = str(vol.get("status") or "NONE")
    else:
        trade_status = str(selected.get("status") or "NONE")
    return {
        "side": side, "selected_source": source,
        "strike": sf(oi.get("strike")) if source in {"BOTH", "OI"} else sf(vol.get("strike")) or sf(oi.get("strike")),
        "oi": oi, "vol": vol, "trade_status": trade_status,
        "shifting_strike": sf(selected.get("shifting_strike")),
        "ratio": sf(selected.get("shifting_per")) / 100.0,
    }


def _infer_ltp_scenario_family(ladder: Mapping[str, Any]) -> str:
    """Replay-validated website scenario family used by ladder exceptions."""
    r, s = (ladder.get("R") or {}), (ladder.get("S") or {})
    r_src = str(r.get("selected_source") or "").upper()
    s_src = str(s.get("selected_source") or "").upper()
    r_state = str(r.get("trade_status") or "").upper()
    s_state = str(s.get("trade_status") or "").upper()
    r_oi_state = str((r.get("oi") or {}).get("status") or "").upper()
    s_vol_state = str((s.get("vol") or {}).get("status") or "").upper()
    if r_src == "VOLUME" and s_src == "VOLUME" and r_state == "STRONG" and s_state == "WTB":
        return "4"
    if r_src == "VOLUME" and s_src == "BOTH" and r_oi_state == "WTB" and s_vol_state == "STRONG":
        return "1"
    if r_src == "BOTH" or s_src == "BOTH" or s_vol_state == "WTT":
        return "5"
    return "1"


def calculate_ltp_ladder(full_rows: Sequence[Mapping[str, Any]], spot: Any, atm: Any, step: Any) -> Dict[str, Any]:
    resistance = _calculated_side(full_rows, "CE", spot, atm, step)
    support = _calculated_side(full_rows, "PE", spot, atm, step)
    result = {
        "mode": "CALCULATED_LTP_STATUS",
        "active_rows": _window_rows(full_rows, spot, atm, step, LTP_ACTIVE_WINDOW_STEPS),
        "R": resistance,
        "S": support,
        "R_Strike": sf(resistance.get("strike")),
        "S_Strike": sf(support.get("strike")),
        "R_Status": resistance.get("selected_source", ""),
        "S_Status": support.get("selected_source", ""),
        "Resistance_Status": resistance.get("trade_status", ""),
        "Support_Status": support.get("trade_status", ""),
    }
    result["scenario_family"] = _infer_ltp_scenario_family(result)

    # Website replay parity: below the ladder anchor, non-family-4 BOTH
    # support uses a wider, lower-side-only PE-OI secondary search.  This does
    # not change the selected support strike; it corrects the displayed OI
    # shifting strike/percentage (209 of 580 snapshots before restoration).
    if result["scenario_family"] != "4" and sf(spot) <= _ltp_il(spot, atm, step):
        support["oi"] = _component(
            full_rows, "PE", "OI", spot, atm, step,
            shift_width=12, shift_filter="LE_ATM",
        )
        # For BOTH, the final side status and shifting strike remain governed
        # by volume; only the displayed OI component is widened here.
    return result


