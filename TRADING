                headers=headers, timeout=self.timeout,
            )
            weekly_response.raise_for_status()
            weekly_payload = weekly_response.json()
            if isinstance(weekly_payload, Sequence) and not isinstance(weekly_payload, (str, bytes)):
                weekly_payload = weekly_payload[0] if weekly_payload else {}
            if isinstance(weekly_payload, Mapping):
                enriched["weekly_range"] = {
                    key: weekly_payload.get(key, "NA") for key in WEEKLY_TV_EXPORT_KEYS
