def refresh_coa_dashboard(book: Any, reference: Mapping[str, Any]) -> None:
    """Refresh only live cells and the active scenario highlight in an open workbook."""
    try:
        ws = book.sheets["COA_Dashboard"]
    except Exception:
        return
    key = _excel_cache_key(book)
    cache = _EXCEL_REFRESH_CACHE.setdefault(key, {})
    mapped = _coa_dashboard_cells(reference)
    signature = tuple(sorted(mapped.items()))
    if cache.get("coa_dashboard_values") != signature:
        for address, value in mapped.items():
            ws.range(address).value = value
        cache["coa_dashboard_values"] = signature
    scenario = int(sf((reference.get("coa") or {}).get("scenario_number")))
    bias = str((reference.get("coa") or {}).get("bias") or "")
    style_signature = (scenario, bias)
    if cache.get("coa_dashboard_scenario_style") != style_signature:
        try:
            ws.range("A12:G20").color = _rgb("white")
            ws.range("A12:G20").font.color = _rgb("black")
            ws.range("A12:G20").font.bold = False
            if 1 <= scenario <= 9:
                active = ws.range(f"A{11 + scenario}:G{11 + scenario}")
                fill = "dash_green" if bias.startswith("BULL") else "dash_red" if bias.startswith("BEAR") else "dash_amber"
                active.color = _rgb(fill)
                active.font.color = _rgb("black" if bias == "NO_TRADE" else "white")
                active.font.bold = True
        except Exception:
            pass
        cache["coa_dashboard_scenario_style"] = style_signature


def _stock_sheet_rows(reference: Mapping[str, Any]) -> List[List[Any]]:
    stock_lines = dict(reference.get("stock_lines") or {})
    if stock_lines.get("source") == "NOT_APPLICABLE_TO_INDEX":
        return [["Status", "Select EQ in LTP_View to load equity lines", "", "", ""]]
    rows: List[List[Any]] = []
    reversal = dict(reference.get("reversal_model") or {})
    source = reference.get("reversal_model_debug", {}).get("source", "")
    for label, field in (
        ("R Risky", "riskyResistance"), ("R Moderate", "moderateResistance"),
        ("R Max Pain", "resistanceSL"), ("R Max Gain", "resistanceTarget"),
        ("S Risky", "riskySupport"), ("S Moderate", "moderateSupport"),
        ("S Max Pain", "supportSL"), ("S Max Gain", "supportTarget"),
    ):
        rows.append([label, reversal.get(field, "NA"), "", "", source])
    for line in stock_lines.get("lines", ()):
        rows.append([line.get("key"), line.get("price"), line.get("max_gain"), line.get("max_pain"), stock_lines.get("source")])
    rows.extend([
        ["Point Value (PV)", stock_lines.get("point_value", 0), "", "", "strikeDifference / 2"],
        ["Bullish Risk", stock_lines.get("bullish_risk", "NA"), "", "", stock_lines.get("source")],
        ["Bearish Risk", stock_lines.get("bearish_risk", "NA"), "", "", stock_lines.get("source")],
        ["Parity", "EXACT" if stock_lines.get("exact_website_parity") else "LOCAL / NATIVE REPORT NOT SUPPLIED", "", "", stock_lines.get("important_limit", "")],
    ])
    return rows


