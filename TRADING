            out = []
            for row in ((payload or {}).get("Table1") or []):
                value = str(row.get("ExpiryDate") or "").strip()
                parts = value.replace("-", " ").split()
                if len(parts) == 3:
                    out.append(f"{parts[0]}-{parts[1]}-{parts[2]}")
            return list(dict.fromkeys(out))

        encoded = self.requests.utils.quote(symbol)
        if instrument == "Equity":
            urls = (
                f"https://www.nseindia.com/api/option-chain-contract-info?symbol={encoded}",
                f"https://www.nseindia.com/api/option-chain-equities?symbol={encoded}",
            )
        else:
            urls = (
                f"https://www.nseindia.com/api/option-chain-indices?symbol={encoded}",
                f"https://www.nseindia.com/api/option-chain-contract-info?symbol={encoded}",
            )
        for url in urls:
            payload = self._json(url)
            records = (payload or {}).get("records") or {}
            values = records.get("expiryDates") if isinstance(records, dict) else None
            values = values or (payload or {}).get("expiryDates")
            if values:
                return [str(item).strip() for item in values if str(item).strip()]
        return []

    @staticmethod
    def choose_expiry(values: Sequence[str], requested: str) -> str:
        values = [str(item).strip() for item in values if str(item).strip()]
        if not values:
            raise RuntimeError("The exchange returned no expiry dates")
        requested = str(requested or "NEAREST").strip()
        parsed_requested = parse_expiry(requested)
        if parsed_requested:
            for value in values:
                parsed = parse_expiry(value)
                if parsed and parsed.date() == parsed_requested.date():
                    return value
            raise RuntimeError(f"Expiry {requested!r} is unavailable. Available: {values}")
        dated = sorted(
            ((parse_expiry(value), value) for value in values if parse_expiry(value)),
            key=lambda pair: pair[0],
        )
        today = datetime.now().date()
        future = [pair for pair in dated if pair[0].date() >= today]
        return (future[0] if future else dated[-1])[1] if dated else values[0]

    def _sensex_chain(self, expiry: str) -> Tuple[List[Dict[str, Any]], float, str]:
        encoded = expiry.replace("-", "+").replace(" ", "+")
        payload = self._json(
            "https://api.bseindia.com/BseIndiaAPI/api/DerivOptionChain_IV/w"
            f"?Expiry={encoded}&scrip_cd=1&strprice=0",
            bse=True,
        )
        table = ((payload or {}).get("Table") or [])
        if not table:
            raise RuntimeError("BSE returned an empty SENSEX option chain")
        spot = sf(table[0].get("UlaValue"))
        market_ts = str(
            table[0].get("UpdTime") or table[0].get("DateTime") or table[0].get("ORDERDTTM") or ""
        )
        rows: List[Dict[str, Any]] = []
        for item in table:
            strike = sf(item.get("Strike_Price1", item.get("Strike_Price")))
            if strike <= 0:
                continue
            rows.append({
                "strikePrice": strike,
                "expiryDate": expiry,
                "CE": {
                    "strikePrice": strike,
                    "openInterest": sf(item.get("C_Open_Interest")),
                    "changeinOpenInterest": sf(item.get("C_Absolute_Change_OI")),
                    "totalTradedVolume": sf(item.get("C_Vol_Traded")),
                    "lastPrice": sf(item.get("C_Last_Trd_Price")),
                    "change": sf(item.get("C_NetChange")),
                    "impliedVolatility": sf(item.get("C_IV", item.get("C_Im_Vol"))),
                    "bidPrice": sf(item.get("C_BidPrice")),
                    "askPrice": sf(item.get("C_OfferPrice")),
                    "underlyingValue": spot,
                },
                "PE": {
                    "strikePrice": strike,
                    "openInterest": sf(item.get("Open_Interest")),
                    "changeinOpenInterest": sf(item.get("Absolute_Change_OI")),
                    "totalTradedVolume": sf(item.get("Vol_Traded")),
                    "lastPrice": sf(item.get("Last_Trd_Price")),
                    "change": sf(item.get("NetChange")),
                    "impliedVolatility": sf(item.get("IV", item.get("Im_Vol"))),
                    "bidPrice": sf(item.get("BidPrice")),
                    "askPrice": sf(item.get("OfferPrice")),
                    "underlyingValue": spot,
                },
            })
        return sorted(rows, key=lambda row: sf(row.get("strikePrice"))), spot, market_ts

    def _nse_chain(self, symbol: str, expiry: str, instrument: str) -> Tuple[List[Dict[str, Any]], float, str, Optional[int]]:
        encoded = self.requests.utils.quote(symbol)
        if instrument == "Equity":
            urls = (
                f"https://www.nseindia.com/api/option-chain-v3?type=Equity&symbol={encoded}&expiry={expiry}",
                f"https://www.nseindia.com/api/option-chain-equities?symbol={encoded}",
            )
        else:
            urls = (
                f"https://www.nseindia.com/api/option-chain-v3?type=Indices&symbol={encoded}&expiry={expiry}",
                f"https://www.nseindia.com/api/option-chain-indices?symbol={encoded}",
            )
        for url in urls:
            payload = self._json(url)
            records = (payload or {}).get("records") or {}
            if not isinstance(records, dict):
                continue
            rows = records.get("data") or []
            rows = [
                row for row in rows
                if not row.get("expiryDate") or str(row.get("expiryDate")).strip() == expiry
            ]
            spot = sf(records.get("underlyingValue"))
            if not rows or spot <= 0:
                continue
            lot = None
            for source in (records, payload or {}):
                for key in ("marketLot", "marketlot", "lotSize", "lotsize"):
                    if source.get(key):
                        lot = int(sf(source.get(key)))
                        break
                if lot:
                    break
            return sorted(rows, key=lambda row: sf(row.get("strikePrice"))), spot, str(records.get("timestamp") or ""), lot
        raise RuntimeError(f"NSE returned no usable {symbol} option-chain rows for {expiry}")

    def snapshot(self, symbol: str, requested_expiry: str, window: int = 10) -> Dict[str, Any]:
        symbol = symbol.upper().strip()
        instrument = "Indices" if symbol in INDEX_CONFIG else "Equity"
        expiries = self.expiries(symbol, instrument)
        expiry = self.choose_expiry(expiries, requested_expiry)
        lot_size: Optional[int] = None
        if symbol == "SENSEX":
            full_rows, spot, market_ts = self._sensex_chain(expiry)
            lot_size = int(INDEX_CONFIG["SENSEX"]["lot_size"])
        else:
            full_rows, spot, market_ts, lot_size = self._nse_chain(symbol, expiry, instrument)
        if not full_rows or spot <= 0:
            raise RuntimeError("The exchange response has no usable strikes or spot value")
        strikes = [sf(row.get("strikePrice")) for row in full_rows]
        step = calc_strike_gap(strikes) or sf(INDEX_CONFIG.get(symbol, {}).get("step"), 1.0)
        atm_index = min(range(len(strikes)), key=lambda idx: abs(strikes[idx] - spot))
        atm = strikes[atm_index]
        display = full_rows[max(0, atm_index-window): min(len(full_rows), atm_index+window+1)]
        return {
            "symbol": symbol,
            "instrument": instrument,
            "expiry": expiry,
            "available_expiries": expiries,
            "spot": spot,
            "atm": atm,
            "step": step,
            "lot_size": lot_size or int(sf(INDEX_CONFIG.get(symbol, {}).get("lot_size"))),
            "market_timestamp": market_ts,
            "received_timestamp": datetime.now().astimezone().isoformat(timespec="seconds"),
            "full_rows": full_rows,
            "display_rows": display,
        }


