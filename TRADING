def calculate_offline_weekly_range(
    full_rows: Sequence[Mapping[str, Any]], spot: Any, atm: Any, step: Any, t_years: Any,
    weekly_anchor: Optional[Mapping[str, Any]] = None,
) -> Tuple[Dict[str, float], Dict[str, Any]]:
    """Calculate the website-style frozen weekly ladder.

    The website's WeeklyRange model stores ``close_price`` and ``close_pv`` for
    ``expiredexpiry``.  Historical replay confirms that the following expiry's
    six levels are a symmetric, week-frozen ladder around those two values:

        R_L_n = close_price + n * close_pv
        S_L_n = close_price - n * close_pv,  n = 1..3

    ``weekly_anchor`` therefore must be the locally saved prior-expiry close
    snapshot.  The live-ATM calculation is retained only as an explicitly
    uncertified cold-start fallback; it is never labelled website parity.
    """
    def tick(value: float) -> float:
        return round(round(value / 0.05) * 0.05, 2)

    sp, at, st = sf(spot), sf(atm), max(sf(step), 0.05)
    anchor = dict(weekly_anchor or {})
    anchor_center = _js_parse_float(anchor.get("close_price"))
    anchor_move = _js_parse_float(anchor.get("close_pv"))
    if anchor_center is not None and anchor_move is not None and anchor_center > 0 and anchor_move > 0:
        center, move = tick(anchor_center), max(0.05, tick(anchor_move))
        levels: Dict[str, float] = {}
        for number in range(1, 4):
            levels[f"R_L_{number}"] = tick(center + number * move)
            levels[f"S_L_{number}"] = tick(center - number * move)
        return levels, {
            "source": "PYTHON_PRIOR_EXPIRY_CLOSE_ANCHOR",
            "center": center,
            "move": move,
            "expired_expiry": anchor.get("expiredexpiry") or anchor.get("expired_expiry"),
            "anchor_time": anchor.get("anchor_time") or anchor.get("fetch_time"),
            "method": "previous-expiry close_price +/- n*close_pv; frozen for the full next-expiry lifecycle",
            "website_formula_claimed": True,
            "parity_tolerance": 0.05,
            "certification_status": "FORMULA_CERTIFIED_INPUT_ANCHOR_REQUIRED",
        }
    row = _row_map(full_rows).get(strike_key(at)) or {}
    call_ltp, put_ltp = _opt(row, "CE", "lastPrice"), _opt(row, "PE", "lastPrice")
    synthetic_center = at + call_ltp - put_ltp
    # Bad or stale ATM quotes must not drag the weekly centre far from spot.
    center = synthetic_center if abs(synthetic_center - sp) <= 2.0 * st else sp
    ivs = [value for value in (_opt(row, "CE", "impliedVolatility"), _opt(row, "PE", "impliedVolatility")) if value > 0]
    atm_iv = sum(ivs) / len(ivs) if ivs else 0.0
    horizon = min(max(sf(t_years), 1.0 / 365.0), 7.0 / 365.0)
    iv_move = sp * (atm_iv / 100.0) * math.sqrt(horizon) if atm_iv > 0 else 0.0
    straddle_move = max(0.0, call_ltp + put_ltp)
    move = min(max(st, iv_move, straddle_move), 8.0 * st)
    center = tick(center)
    move = max(st, tick(move))
    levels: Dict[str, float] = {}
    for number in range(1, 4):
        levels[f"R_L_{number}"] = tick(center + number * move)
        levels[f"S_L_{number}"] = tick(center - number * move)
    return levels, {
        "source": "PYTHON_NSE_OPTION_CHAIN_EXPECTED_MOVE",
        "center": center, "move": move, "atm_iv": atm_iv,
        "atm_straddle": straddle_move, "horizon_days": horizon * 365.0,
        "method": "ATM synthetic-forward centre; max of ATM straddle, IV expected move and one strike step; six symmetric bands",
        "website_formula_claimed": False,
        "certification_status": "COLD_START_FALLBACK_NOT_WEBSITE_PARITY",
        "missing_required_anchor_fields": ["close_price", "close_pv", "expiredexpiry"],
    }


# ---- Exact V53 snapshot boundary-dominance formula ------------------------
def dominance(iv: Any, oi: Any, vol: Any, oichg: Any) -> float:
    ivf = sf(iv)
    return ivf * (DOM_W_OI * sf(oi) + DOM_W_VOL * sf(vol) + DOM_W_OICHG * max(sf(oichg), 0.0)) if ivf > 0 else 0.0


def build_boundaries(full_rows: Sequence[Mapping[str, Any]], step: Any) -> Dict[Any, float]:
    st, rows = sf(step), list(full_rows)
    row_map = _row_map(rows)
    boundaries: Dict[Any, float] = {}
    for k, lower in row_map.items():
        ku = strike_key(sf(k) + st)
        if ku not in row_map: continue
        upper = row_map[ku]
        dce = dominance(_opt(lower, "CE", "impliedVolatility"), _opt(lower, "CE", "openInterest"), _opt(lower, "CE", "totalTradedVolume"), _opt(lower, "CE", "changeinOpenInterest"))
        dpe = dominance(_opt(upper, "PE", "impliedVolatility"), _opt(upper, "PE", "openInterest"), _opt(upper, "PE", "totalTradedVolume"), _opt(upper, "PE", "changeinOpenInterest"))
        weight = 0.5 if dce + dpe <= 0 else dce / (dce + dpe)
        boundaries[k] = sf(k) + weight * st
    return boundaries


def compute_max_pain(full_rows: Sequence[Mapping[str, Any]]) -> Any:
    strikes = sorted({sf(r.get("strikePrice")) for r in full_rows if sf(r.get("strikePrice")) > 0})
    rows = {sf(r.get("strikePrice")): r for r in full_rows}
    best_k, best_pain = None, None
    for settle in strikes:
        pain = sum(max(0.0, settle - k) * _opt(rows[k], "CE", "openInterest") + max(0.0, k - settle) * _opt(rows[k], "PE", "openInterest") for k in strikes)
        if best_pain is None or pain < best_pain: best_k, best_pain = settle, pain
    return strike_key(best_k) if best_k is not None else ""


def snapshot_boundary_levels(full_rows: Sequence[Mapping[str, Any]], spot: Any, atm: Any, step: Any) -> Dict[str, Any]:
    st = sf(step) or calc_strike_gap(r.get("strikePrice") for r in full_rows) or 1.0
    focus = nearest_strike(full_rows, sf(atm) or sf(spot))
    boundaries = build_boundaries(full_rows, st)
    b = lambda k: sf(boundaries.get(strike_key(k), sf(strike_key(k)) + 0.5 * st))
    return {
        "R_EXT": b(sf(focus) + st), "R_DIV": b(focus),
        "S_DIV": b(sf(focus) - st), "S_EXT": b(sf(focus) - 2 * st),
        "max_pain": compute_max_pain(full_rows),
        "max_pain_top": b(sf(focus) + 2 * st),
        "max_pain_bot": b(sf(focus) - 3 * st),
    }


def dominance_status(levels: Mapping[str, Any], spot: Any) -> Dict[str, Any]:
    sp = sf(spot); re, rd, sd, se = (sf(levels.get(k)) for k in ("R_EXT", "R_DIV", "S_DIV", "S_EXT"))
    if re > 0 and sp >= re: rs, rn, rv = "BREAK_OUT", "R_BREAK", re
    elif sp >= rd: rs, rn, rv = "TESTING_BREAK", "R_TEST", rd
    elif abs(sp - rd) <= DOMINANCE_TEST_BUFFER_POINTS: rs, rn, rv = "NEAR_TEST", "R_NEAR", rd
    else: rs, rn, rv = "SUSTAIN", "R_SUSTAIN", rd
    if se > 0 and sp <= se: ss, sn, sv = "BREAK_DOWN", "S_BREAK", se
    elif sp <= sd: ss, sn, sv = "TESTING_BREAK", "S_TEST", sd
    elif abs(sp - sd) <= DOMINANCE_TEST_BUFFER_POINTS: ss, sn, sv = "NEAR_TEST", "S_NEAR", sd
    else: ss, sn, sv = "SUSTAIN", "S_SUSTAIN", sd
    if rs == "BREAK_OUT": bias = "UP_DOMINANCE_BREAK"
    elif ss == "BREAK_DOWN": bias = "DOWN_DOMINANCE_BREAK"
    elif rs in {"TESTING_BREAK", "NEAR_TEST"}: bias = "RESISTANCE_UNDER_TEST"
    elif ss in {"TESTING_BREAK", "NEAR_TEST"}: bias = "SUPPORT_UNDER_TEST"
    else: bias = "BOUNDARY_SUSTAIN"
    return {
        "dom_res_status": rs, "dom_sup_status": ss,
        "dom_res_plot_name": rn, "dom_sup_plot_name": sn,
        "dom_res_plot_value": rv, "dom_sup_plot_value": sv,
        "dom_direction_bias": bias,
        "dom_sustain_break_note": f"R={rs} ({rd-sp:+.2f} pts vs R_DIV); S={ss} ({sp-sd:+.2f} pts vs S_DIV); Bias={bias}",
    }


def _observation_session(value: Any) -> str:
    text = str(value or "").strip()
    for pattern in ("%d-%b-%Y %H:%M:%S", "%d-%m-%Y %H:%M:%S", "%Y-%m-%d %H:%M:%S", "%Y-%m-%dT%H:%M:%S"):
        try:
            return datetime.strptime(text[:19], pattern).date().isoformat()
        except ValueError:
            pass
    return text[:10]


def build_line_confirmation(
    levels: Mapping[str, Any],
    ladder: Mapping[str, Any],
    spot: Any,
    step: Any,
    state_key: Optional[str] = None,
    observation_id: Any = None,
    required_distinct_snapshots: int = 2,
) -> Dict[str, Any]:
    """Confirm a current sustain/break condition without predicting the future."""
    sp, st = sf(spot), max(sf(step), 1.0)
    test_buffer = max(DOMINANCE_TEST_BUFFER_POINTS, st * 0.10)
    required = max(2, int(required_distinct_snapshots))
    observation = str(observation_id or "").strip()
    session = _observation_session(observation)
    key = str(state_key or "STATELESS")
    persistent = bool(state_key and observation)
    state = _LINE_CONFIRMATION_STATE.setdefault(key, {}) if persistent else {}
    if persistent and state.get("session") != session:
        state.clear()
        state["session"] = session
    is_new_observation = not persistent or state.get("last_observation") != observation

    definitions = {
        "resistance": {
            "level": sf(levels.get("R_DIV")), "extension": sf(levels.get("R_EXT")),
            "raw": str(levels.get("dom_res_status") or ""),
            "chain": _coa_state((ladder.get("R") or {}).get("trade_status")),
        },
        "support": {
            "level": sf(levels.get("S_DIV")), "extension": sf(levels.get("S_EXT")),
            "raw": str(levels.get("dom_sup_status") or ""),
            "chain": _coa_state((ladder.get("S") or {}).get("trade_status")),
        },
    }
    output: Dict[str, Any] = {}
    for side, item in definitions.items():
        raw, chain, level = item["raw"], item["chain"], item["level"]
        if raw in {"BREAK_OUT", "BREAK_DOWN"}:
            candidate = "BREAK"
        elif raw in {"TESTING_BREAK", "NEAR_TEST"} or abs(sp - level) <= test_buffer:
            candidate = "TESTING"
        else:
            candidate = "SUSTAIN"

        side_state = state.setdefault(side, {}) if persistent else {}
        if is_new_observation:
            count = int(side_state.get("count", 0)) + 1 if side_state.get("candidate") == candidate else 1
            side_state.update({"candidate": candidate, "count": count})
        else:
            count = int(side_state.get("count", 0))

        if side == "resistance":
            chain_agrees = chain == ("WTT" if candidate == "BREAK" else "STRONG") or (candidate == "SUSTAIN" and chain == "WTB")
            chain_meaning = {
                "WTT": "call pressure shifted higher; resistance is weakening",
                "WTB": "call pressure shifted lower; resistance is defending",
                "STRONG": "call pressure has no confirmed 75% shift; resistance is defending",
            }.get(chain, "call-pressure evidence unavailable")
            distance = level - sp
        else:
            chain_agrees = chain == ("WTB" if candidate == "BREAK" else "STRONG") or (candidate == "SUSTAIN" and chain == "WTT")
            chain_meaning = {
                "WTB": "put pressure shifted lower; support is weakening",
                "WTT": "put pressure shifted higher; support is defending",
                "STRONG": "put pressure has no confirmed 75% shift; support is defending",
            }.get(chain, "put-pressure evidence unavailable")
            distance = sp - level

        if candidate == "TESTING":
            result, confirmation = "TESTING", "WAIT"
        elif count < required:
            result, confirmation = "UNCONFIRMED", f"{count}/{required} SNAPSHOTS"
        elif chain_agrees:
            result, confirmation = candidate, "CONFIRMED"
        elif candidate == "BREAK":
            result, confirmation = "BREAK", "PRICE CONFIRMED / CHAIN CONFLICT"
        else:
            result, confirmation = "UNCONFIRMED", "CHAIN CONFLICT"
        label = side.upper()
        summary = (
            f"{label}: {result} | {confirmation} | line {level:.2f}, spot {sp:.2f}, "
            f"safe-side gap {distance:+.2f} | {chain} - {chain_meaning}"
        )
        output[side] = {
            "result": result, "candidate": candidate, "confirmation": confirmation,
            "confirmed": confirmation == "CONFIRMED", "chain_agrees": chain_agrees,
            "chain_state": chain, "chain_meaning": chain_meaning,
            "line": level, "extension": item["extension"], "spot": sp,
            "safe_side_gap": round(distance, 4), "test_buffer": test_buffer,
            "distinct_snapshot_count": count, "required_distinct_snapshots": required,
            "raw_price_state": raw, "summary": summary,
        }
    if persistent and is_new_observation:
        state["last_observation"] = observation
    return {
        **output,
        "observation_id": observation,
        "session": session,
        "method": "two distinct exchange snapshots plus option-chain pressure agreement",
        "important_limit": "Confirmation describes current evidence; it does not guarantee that a line will hold or break next.",
    }


def dominance_tv_export(levels: Mapping[str, Any]) -> str:
    mp = levels.get("max_pain", "")
    parts = [
        f"R_EXT={sf(levels.get('R_EXT')):.2f}", f"R_DIV={sf(levels.get('R_DIV')):.2f}",
        f"S_DIV={sf(levels.get('S_DIV')):.2f}", f"S_EXT={sf(levels.get('S_EXT')):.2f}",
        f"MaxPain={sf(mp):.0f}" if str(mp).strip() else "MaxPain=",
        f"MP_Top={sf(levels.get('max_pain_top')):.2f}", f"MP_Bot={sf(levels.get('max_pain_bot')):.2f}",
    ]
    for side in ("res", "sup"):
        value = sf(levels.get(f"dom_{side}_plot_value"))
        if value > 0: parts.append(f"{levels.get(f'dom_{side}_plot_name')}={value:.2f}")
    return " | ".join(parts)


def build_option_chain_table_rows(
    full_rows: Sequence[Mapping[str, Any]],
    spot: Any,
    t_years: Any,
    ce_map: Mapping[Any, Any],
    pe_map: Mapping[Any, Any],
) -> List[List[str]]:
    """Return the canonical 13-column V53/live-website display values."""
    rows, sp, t = list(full_rows), sf(spot), max(sf(t_years), SREV_MIN_T_YEARS)
    rankings = website_chain_rankings(rows)

    def pct(value: float, side: str, field: str) -> float:
        maximum = rankings[f"{side}_{field}"]["highest"]
        return value / maximum * 100.0 if maximum else 0.0

    table: List[List[str]] = []
    for row in rows:
        k = sf(row.get("strikePrice"))
        coi, poi = _opt(row, "CE", "openInterest"), _opt(row, "PE", "openInterest")
        coc, poc = _opt(row, "CE", "changeinOpenInterest"), _opt(row, "PE", "changeinOpenInterest")
        cvol, pvol = _opt(row, "CE", "totalTradedVolume"), _opt(row, "PE", "totalTradedVolume")
        civ, piv = _opt(row, "CE", "impliedVolatility"), _opt(row, "PE", "impliedVolatility")
        cdelta, pdelta = calc_delta(sp, k, t, civ, True), calc_delta(sp, k, t, piv, False)
        pcr_oi = poi / coi if coi > 0 else 0.0
        pcr_c = poc / coc if coc > 0 else 0.0
        table.append([
            f"{civ:.1f}\n{cdelta:.2f}",
            f"{fmt_indian(coc)}\n{pct(coc, 'CE', 'changeinOpenInterest'):.2f}%",
            f"{fmt_indian(coi)}\n{pct(coi, 'CE', 'openInterest'):.2f}%",
            f"{fmt_indian(cvol)}\n{pct(cvol, 'CE', 'totalTradedVolume'):.2f}%",
            f"{_opt(row, 'CE', 'lastPrice'):.2f}\n({_opt(row, 'CE', 'change'):+.1f})",
            srev_cell("CE", sp, ce_map.get(strike_key(k))),
            f"{k:.0f}\nPCR {pcr_oi:.2f}/{pcr_c:.2f}",
            srev_cell("PE", sp, pe_map.get(strike_key(k))),
            f"{_opt(row, 'PE', 'lastPrice'):.2f}\n({_opt(row, 'PE', 'change'):+.1f})",
            f"{fmt_indian(pvol)}\n{pct(pvol, 'PE', 'totalTradedVolume'):.2f}%",
            f"{fmt_indian(poi)}\n{pct(poi, 'PE', 'openInterest'):.2f}%",
            f"{fmt_indian(poc)}\n{pct(poc, 'PE', 'changeinOpenInterest'):.2f}%",
            f"{piv:.1f}\n{pdelta:.2f}",
        ])
    return table


