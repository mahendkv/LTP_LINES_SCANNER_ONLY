def _changed_runs(old: Sequence[Any], new: Sequence[Any]) -> List[Tuple[int, int]]:
    """Return inclusive zero-based runs whose values changed."""
    changed = [i for i, value in enumerate(new) if i >= len(old) or old[i] != value]
    if not changed:
        return []
    runs: List[Tuple[int, int]] = []
    start = end = changed[0]
    for index in changed[1:]:
        if index == end + 1:
            end = index
        else:
            runs.append((start, end)); start = end = index
    runs.append((start, end))
    return runs


def _enter_excel_fast_mode(book: Any, visual_freeze: bool = False) -> Dict[str, Any]:
    """Enter a lightweight Excel update mode without causing refresh flicker.

    ScreenUpdating is toggled only for rare style/layout changes. Calculation is
    intentionally left alone: this workbook has no live formulas that justify a
    manual/automatic calculation flip every 15 seconds, and that flip can make
    Excel visibly pause.
    """
    app = book.app
    state: Dict[str, Any] = {}
    for name in ("enable_events", "display_alerts"):
        try:
            state[name] = getattr(app, name)
            setattr(app, name, False)
        except Exception:
            pass
    if visual_freeze:
        try:
            state["screen_updating"] = app.screen_updating
            app.screen_updating = False
        except Exception:
            pass
    return state


def _leave_excel_fast_mode(book: Any, state: Mapping[str, Any]) -> None:
    app = book.app
    for name, value in state.items():
        try:
            if name == "display_status_bar": app.api.DisplayStatusBar = value
            else: setattr(app, name, value)
        except Exception: pass


def _chain_style_signature(row: Mapping[str, Any], reference: Mapping[str, Any], rankings: Mapping[str, Any]) -> Tuple[Any, ...]:
    strike, spot = sf(row.get("strikePrice")), sf(reference["spot"])
    ranked = []
    for side, field in (
        ("CE","changeinOpenInterest"),("CE","openInterest"),("CE","totalTradedVolume"),
        ("PE","totalTradedVolume"),("PE","openInterest"),("PE","changeinOpenInterest"),
    ):
        raw = _opt(row, side, field)
        ranked.extend((website_chain_fill_name(side, field, raw, strike, spot, rankings), website_chain_bold(side, field, raw, rankings)))
    return (
        spot >= strike, spot < strike, abs(strike - sf(reference.get("atm"))) < 1e-9,
        *ranked,
        _opt(row,"CE","changeinOpenInterest") < 0, _opt(row,"PE","changeinOpenInterest") < 0,
        (0 < _opt(row,"CE","change")) - (_opt(row,"CE","change") < 0),
        (0 < _opt(row,"PE","change")) - (_opt(row,"PE","change") < 0),
    )


def _format_live_chain_row(ws: Any, excel_row: int, row: Mapping[str, Any], reference: Mapping[str, Any], rankings: Mapping[str, Any]) -> None:
    strike, spot = sf(row.get("strikePrice")), sf(reference["spot"])
    full = ws.range((excel_row, 1), (excel_row, 13))
    full.color = _rgb("white"); full.font.color = _rgb("black"); full.font.bold = False
    full.api.WrapText = True; full.api.HorizontalAlignment = -4108; full.api.VerticalAlignment = -4108
    full.rows.row_height = 28; full.api.Borders.LineStyle = 1
    if spot >= strike: ws.range((excel_row, 1), (excel_row, 6)).color = _rgb("website_gray")
    if spot < strike: ws.range((excel_row, 8), (excel_row, 13)).color = _rgb("website_gray")
    if abs(strike - sf(reference.get("atm"))) < 1e-9:
        ws.range((excel_row, 1), (excel_row, 6)).color = _rgb("atm_row")
        ws.range((excel_row, 8), (excel_row, 13)).color = _rgb("atm_row")
    strike_cell = ws.range((excel_row, 7))
    strike_cell.color = _rgb("orange"); strike_cell.font.color = _rgb("white"); strike_cell.font.bold = True
    for column, side, field, raw in (
        (2,"CE","changeinOpenInterest",_opt(row,"CE","changeinOpenInterest")),
        (3,"CE","openInterest",_opt(row,"CE","openInterest")),
        (4,"CE","totalTradedVolume",_opt(row,"CE","totalTradedVolume")),
        (10,"PE","totalTradedVolume",_opt(row,"PE","totalTradedVolume")),
        (11,"PE","openInterest",_opt(row,"PE","openInterest")),
        (12,"PE","changeinOpenInterest",_opt(row,"PE","changeinOpenInterest")),
    ):
        cell = ws.range((excel_row, column))
        cell.color = _rgb(website_chain_fill_name(side, field, raw, strike, spot, rankings))
        cell.font.bold = website_chain_bold(side, field, raw, rankings)
    ws.range((excel_row,2)).font.color = _rgb("red" if _opt(row,"CE","changeinOpenInterest") < 0 else "dark_green")
    ws.range((excel_row,12)).font.color = _rgb("red" if _opt(row,"PE","changeinOpenInterest") < 0 else "dark_green")
    for column, side in ((5,"CE"),(9,"PE")):
        change = _opt(row, side, "change")
        ws.range((excel_row,column)).font.color = _rgb("dark_green" if change > 0 else "red" if change < 0 else "black")
    for column in (6, 8):
        state_text = str(ws.range((excel_row,column)).value or "").upper()
        cell = ws.range((excel_row,column))
        cell.font.color = _rgb("red" if "BREAK OUT" in state_text else "dark_green" if "BREAK DOWN" in state_text else "blue" if "ACTIVE" in state_text else "black")
        cell.font.bold = "BREAK" in state_text


def refresh_open_workbook(
    book: Any,
    reference: Mapping[str, Any],
    expiries: Sequence[str],
    equity_symbols: Optional[Sequence[str]] = None,
    market_tracker_rows: Optional[Sequence[Mapping[str, Any]]] = None,
) -> None:
    """Differential, freeze-resistant refresh of an already-open workbook."""
    ws = book.sheets["LTP_View"]
    rows = list(reference["full_rows"])
    values = build_option_chain_table_rows(
        rows, reference["spot"], reference["t_years"],
        reference["ce_sreversal"], reference["pe_sreversal"],
    )
    value_rows = tuple(tuple(row) for row in values)
    key = _excel_cache_key(book)
    cache = _EXCEL_REFRESH_CACHE.setdefault(key, {})
    refresh_coa_dashboard(book, reference)
    old_values = cache.get("values", ())
    rankings = website_chain_rankings(rows)
    style_signatures = tuple(_chain_style_signature(row, reference, rankings) for row in rows)
    old_styles = cache.get("styles", ())
    changed_style_rows = {i for i, sig in enumerate(style_signatures) if i >= len(old_styles) or old_styles[i] != sig}
    trade_header = reference["option_chain_trade_header"]
    header_values = {
        "A1": f"{reference['symbol']} CALL SIDE", "G1": round(sf(reference["spot"]), 2),
        "H1": f"{reference['symbol']} PUT SIDE",
        "A3": trade_header["call_shift"], "H3": trade_header["put_shift"],
        "O4": reference["expiry"],
    }
    # Avoid the visible off/on ScreenUpdating flicker on normal value refreshes.
    # Freeze painting only when a row's formatting state actually changed.
    fast_state = _enter_excel_fast_mode(book, visual_freeze=bool(changed_style_rows))
    dirty = False
    try:
        if cache.get("line_export_layout") != "LIGHT_TWO_COLUMN_V2":
            try:
                ws.range("Q1:AG9").unmerge()
                ws.range("Q1:AG9").clear_contents()
                ws.range("Q10:AG11").unmerge()
                ws.range("Q10:AG11").clear()
                for address in ("Q1:AG1", "Q2:R2", "S2:X2", "Q3:R3", "S3:X3", "Q4:R4", "S4:X4", "Q5:R5", "S5:X5", "Z2:AA2", "AB2:AG2", "Z3:AA3", "AB3:AG3", "Z4:AA4", "AB4:AG4", "Z5:AA5", "AB5:AG5"):
                    ws.range(address).merge()
                for address, value in {
                    "Q1":"TRADINGVIEW LINE EXPORTS",
                    "Q2":"LIVE PYTHON (6)", "Q3":"FROZEN 09:20 LOCAL (4)",
                    "Q4":"AI-LTP PYTHON (MAX 8)", "Q5":"DOMINANCE (8)",
                    "Z2":"WEEKLY PYTHON (6)", "Z3":"D1/D2/D3 PYTHON",
                    "Z4":"OPTIONAL WEBSITE CHECK", "Z5":"PARITY VALIDATION",
                }.items():
                    ws.range(address).value = value
                ws.range("Q1:AG1").color = _rgb("tv_light_header")
                ws.range("Q1:AG1").font.color = _rgb("black")
                ws.range("Q1:AG1").font.bold = True
                for address in ("Q2:R5", "Z2:AA5"):
                    ws.range(address).color = _rgb("tv_light_label")
                    ws.range(address).font.color = _rgb("black")
                    ws.range(address).font.bold = True
                for address in ("S2:X5", "AB2:AG5"):
                    ws.range(address).color = _rgb("tv_light_value")
                    ws.range(address).font.color = _rgb("black")
                ws.range("Y1:Y5").color = _rgb("white")
                cache["line_export_layout"] = "LIGHT_TWO_COLUMN_V2"
                dirty = True
            except Exception:
                # Newly generated workbooks already have this layout; a locked
                # legacy workbook will be migrated on the next refresh.
                pass
        for address, value in header_values.items():
            if cache.get("headers", {}).get(address) != value:
                ws.range(address).value = value; dirty = True
        for start, end in _changed_runs(old_values, value_rows):
            ws.range((5 + start, 1), (5 + end, 13)).value = values[start:end + 1]
            # Do not reformat rows merely because LTP/OI/volume values changed.
            # Formatting depends only on the separate style signature above.
            dirty = True
        if len(old_values) > len(values):
            ws.range((5 + len(values), 1), (4 + len(old_values), 13)).clear_contents(); dirty = True
        for index in sorted(changed_style_rows):
            if index < len(rows): _format_live_chain_row(ws, 5 + index, rows[index], reference, rankings)

        confirmation = reference["line_confirmation"]
        panel = {
            "S2": reference.get("live_six_tv_export", "") or "INSUFFICIENT OPTION-CHAIN DATA",
            "S3": reference.get("nine_twenty_tv_export", "") or "WAITING FOR LOCALLY STORED 09:20 SNAPSHOT",
            "S4": reference.get("magical_tv_export", "") or "NO ACTIVE CONDITIONAL AI-LTP LINES",
            "S5": reference.get("dominance_tv_export", "") or "NO ACTIVE NUMERIC LINES",
            "AB2": reference.get("weekly_tv_export", "") or "INSUFFICIENT OPTION-CHAIN DATA",
            "AB3": reference.get("d_overlay_tv_export", "") or "NO ACTIVE D OVERLAYS",
            "AB4": reference.get("website_comparison_summary", "") or "OPTIONAL WEBSITE CHECK NOT RUN — PYTHON CALCULATIONS ACTIVE",
            "AB5": (reference.get("parity_safety_gate") or {}).get("status", "NOT EVALUATED"),
        }
        for address, value in panel.items():
            if cache.get("panel", {}).get(address) != value:
                ws.range(address).value = value; dirty = True

        equities = tuple(sorted(dict.fromkeys(
            [str(item).upper().strip() for item in (equity_symbols or EQUITY_SYMBOL_FALLBACK) if str(item).strip()]
        )))
        metadata = (tuple(expiries), tuple(INDEX_CONFIG), equities)
        if cache.get("metadata") != metadata:
            meta = book.sheets["Metadata"]
            old_meta_len = int(cache.get("metadata_length", 0))
            new_meta_len = max(len(expiries), len(INDEX_CONFIG), len(equities), 2)
            if old_meta_len > new_meta_len:
                meta.range((2,1),(1+old_meta_len,4)).clear_contents()
            meta.range("A2").options(transpose=True).value = list(expiries)
            meta.range("B2").options(transpose=True).value = list(INDEX_CONFIG)
            meta.range("C2").options(transpose=True).value = list(equities)
            meta.range("D2:D3").value = [["INDEX"], ["EQ"]]
            dirty = True

        stock_rows = _stock_sheet_rows(reference)
        stock_signature = tuple(tuple(row) for row in stock_rows)
        if cache.get("stock_rows") != stock_signature and "Stock_Lines" in [sheet.name for sheet in book.sheets]:
            stock_ws = book.sheets["Stock_Lines"]
            old_count = int(cache.get("stock_row_count", 0))
            if old_count > len(stock_rows):
                stock_ws.range((2 + len(stock_rows), 1), (1 + old_count, 5)).clear_contents()
            stock_ws.range((2, 1), (1 + len(stock_rows), 5)).value = stock_rows
            dirty = True
        tracker_values = tuple(tuple(row) for row in market_tracker_excel_rows(market_tracker_rows or ()))
        if cache.get("market_tracker_rows") != tracker_values and "Market_Tracker" in [sheet.name for sheet in book.sheets]:
            tracker_ws = book.sheets["Market_Tracker"]
            old_tracker_count = int(cache.get("market_tracker_row_count", 0))
            if old_tracker_count > len(tracker_values):
                tracker_ws.range((5 + len(tracker_values), 1), (4 + old_tracker_count, 15)).clear_contents()
            if tracker_values:
                tracker_ws.range((5, 1), (4 + len(tracker_values), 15)).value = [list(row) for row in tracker_values]
            dirty = True
        audit_rows = (
            ("Reference Version",REFERENCE_VERSION),("COA Rule Version",COA_RULE_VERSION),("Option Chain Format",OPTION_CHAIN_FORMAT_VERSION),
            ("Build Scope","CALCULATIONS AND SCANNER ONLY — NO TRADING LOGIC"),("Symbol",reference["symbol"]),("Expiry",reference["expiry"]),
            ("Parity Gate Version",PARITY_GATE_VERSION),("Parity Gate Status",(reference.get("parity_safety_gate") or {}).get("status","NOT EVALUATED")),
            ("Parity Tolerance Points",PARITY_TOLERANCE_POINTS),
            ("Market Timestamp",reference.get("market_timestamp","")),("Spot",reference["spot"]),
            ("ATM",reference["atm"]),("Step",reference["step"]),
            ("Parity Status",reference["parity_certification"]["status"]),
            ("COA Scenario",reference["coa"]["scenario_number"]),("COA Name",reference["coa"].get("name")),("COA Bias",reference["coa"]["bias"]),
            ("Resistance Confirmation",confirmation["resistance"]["summary"]),
            ("Support Confirmation",confirmation["support"]["summary"]),
            ("Confirmation Method",confirmation["method"]),
            ("Intraday History",intraday_history_summary(reference.get("intraday_history") or {})),
            ("Intraday Database",(reference.get("intraday_history") or {}).get("database","")),
            ("Operational Source","PYTHON OPTION-CHAIN CALCULATION"),
            ("Website Comparison",reference.get("website_comparison_summary","NOT RUN")),
            ("Line Family Counts",json.dumps(reference.get("line_family_status",{}),sort_keys=True)),
            ("Live Six TV Export",reference["live_six_tv_export"]),("09:20 TV Export",reference["nine_twenty_tv_export"]),("AI-LTP TV Export",reference["magical_tv_export"]),
            ("Weekly W TV Export",reference.get("weekly_tv_export","")),("D Overlay TV Export",reference.get("d_overlay_tv_export","")),
            ("Dominance TV Export",reference["dominance_tv_export"]),
        )
        old_audit = cache.get("audit", ())
        audit = book.sheets["Reference_Audit"]
        for start, end in _changed_runs(old_audit, audit_rows):
            audit.range((2+start,1),(2+end,2)).value = [list(item) for item in audit_rows[start:end+1]]; dirty = True

        cache.update(values=value_rows, styles=style_signatures,
                     headers=dict(header_values), panel=dict(panel),
                     metadata=metadata, metadata_length=max(len(expiries),len(INDEX_CONFIG),len(equities),2), audit=audit_rows,
                     stock_rows=stock_signature, stock_row_count=len(stock_rows),
                     market_tracker_rows=tracker_values, market_tracker_row_count=len(tracker_values))
        # Disk persistence is intentionally throttled; the visible workbook is
        # current every cycle, while .xlsx serialization no longer freezes Excel.
        now = time.monotonic()
        if dirty and now - sf(cache.get("last_save"), -1e9) >= EXCEL_SAVE_INTERVAL_SECONDS:
            book.save(); cache["last_save"] = now
    finally:
        _leave_excel_fast_mode(book, fast_state)


