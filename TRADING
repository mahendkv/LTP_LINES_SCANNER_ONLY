def apply_frozen_nine_twenty(
    reference: Dict[str, Any],
    anchor_snapshot: Optional[Mapping[str, Any]],
    saved_values: Optional[Mapping[str, Any]] = None,
) -> None:
    """Replace the current-line proxy with a genuine stored 09:20 snapshot."""
    if not anchor_snapshot and saved_values:
        raw_values = dict(saved_values.get("values") or saved_values)
        valid_values = {
            key: sf(raw_values.get(key)) for key in NINE_TWENTY_TV_EXPORT_KEYS
        }
        if all(value > 0 and math.isfinite(value) for value in valid_values.values()):
            nine = dict(reference.get("nine_twenty_strategy") or {})
            nine.update({
                "source": str(saved_values.get("source") or "SAVED_09_20_VALUES"),
                "value_source": "PYTHON_CALCULATED_NSE_OPTION_CHAIN",
                "anchor_market_timestamp": str(saved_values.get("market_timestamp") or ""),
                "anchor_spot": sf(saved_values.get("spot")),
                "all_four_visible": True,
                "all_four_current_numeric": True,
                "line_set_complete": True,
                "line_state": {
                    key: {
                        "value": value, "visible": True,
                        "current_numeric": True, "carried_forward": False,
                    }
                    for key, value in valid_values.items()
                },
            })
            reference["nine_twenty_strategy"] = nine
            reference["nine_twenty_tv_export"] = nine_twenty_tv_export(nine)
            reference["option_chain_trade_header"] = build_option_chain_trade_header(
                reference.get("ltp_ladder") or {}, reference.get("coa") or {}, nine,
                reference.get("reversal_model_debug") or {},
            )
            refresh_line_family_status(reference)
            return
    if not anchor_snapshot:
        nine = dict(reference.get("nine_twenty_strategy") or {})
        nine.update({
            "source": "UNAVAILABLE_NO_09_20_SNAPSHOT",
            "anchor_market_timestamp": "",
            "all_four_visible": False,
            "all_four_current_numeric": False,
            "line_set_complete": False,
        })
        reference["nine_twenty_strategy"] = nine
        reference["nine_twenty_tv_export"] = ""
        reference["option_chain_trade_header"] = build_option_chain_trade_header(
            reference.get("ltp_ladder") or {}, reference.get("coa") or {}, nine,
            reference.get("reversal_model_debug") or {},
        )
        refresh_line_family_status(reference)
        return

    anchor_bundle = build_canonical_bundle(
        anchor_snapshot["full_rows"], anchor_snapshot["spot"],
        anchor_snapshot["atm"], anchor_snapshot["step"], anchor_snapshot["expiry"],
        plot_state_key=f"{anchor_snapshot['symbol']}|{anchor_snapshot['expiry']}|09:20",
        observation_id=anchor_snapshot.get("market_timestamp"), instrument_kind="INDEX",
        reversal_model=anchor_snapshot.get("reversal_model"),
        website_status=anchor_snapshot.get("website_rs_status"),
        weekly_range=anchor_snapshot.get("weekly_range"),
        website_native_status=str(anchor_snapshot.get("website_native_status") or ""),
        website_native_live_lines=anchor_snapshot.get("website_native_live_lines"),
    )
    nine = dict(anchor_bundle["nine_twenty_strategy"])
    # The frozen 09:20 family is the four numeric Live-line values captured at
    # the anchor tick.  Do not retain conditional visibility flags from the
    # live proxy: those flags can suppress a valid anchor value and previously
    # caused the four-line export (and the built-in regression test) to fail.
    anchor_live = dict(anchor_bundle.get("live_magical_lines") or {})
    frozen_values = {
        key: _js_parse_float(anchor_live.get(key))
        for key in NINE_TWENTY_TV_EXPORT_KEYS
    }
    frozen_complete = all(
        value is not None and value > 0 and math.isfinite(value)
        for value in frozen_values.values()
    )
    frozen_line_state = {
        key: {
            "value": value if value is not None else "NA",
            "visible": value is not None and value > 0,
            "current_numeric": value is not None and value > 0,
            "carried_forward": False,
        }
        for key, value in frozen_values.items()
    }
    nine.update({
        "source": "FROZEN_LOCAL_09_20_OPTION_CHAIN_SNAPSHOT",
        "value_source": "PYTHON_CALCULATED_NSE_OPTION_CHAIN",
        "anchor_market_timestamp": anchor_snapshot.get("market_timestamp", ""),
        "anchor_spot": sf(anchor_snapshot.get("spot")),
        "all_four_visible": frozen_complete,
        "all_four_current_numeric": frozen_complete,
        "line_set_complete": frozen_complete,
        "line_state": frozen_line_state,
    })
    reference["nine_twenty_strategy"] = nine
    reference["nine_twenty_tv_export"] = nine_twenty_tv_export(nine)
    reference["option_chain_trade_header"] = build_option_chain_trade_header(
        reference.get("ltp_ladder") or {}, reference.get("coa") or {}, nine,
        reference.get("reversal_model_debug") or {},
    )
    refresh_line_family_status(reference)


def load_saved_nine_twenty(path: Path, snapshot: Mapping[str, Any]) -> Optional[Dict[str, Any]]:
    """Load a same-session, same-symbol/expiry frozen-line record."""
    if not Path(path).exists():
        return None
    try:
        payload = json.loads(Path(path).read_text(encoding="utf-8"))
    except (OSError, ValueError, TypeError):
        return None
    expected_session = _observation_session(snapshot.get("market_timestamp"))
    if (
        str(payload.get("schema_version") or "") != "NINE_TWENTY_FROZEN_LINES_3.0"
        or str(payload.get("value_source") or "") != "PYTHON_CALCULATED_NSE_OPTION_CHAIN"
        or
        str(payload.get("session_date") or "") != expected_session
        or str(payload.get("symbol") or "").upper() != str(snapshot.get("symbol") or "").upper()
        or str(payload.get("expiry") or "") != str(snapshot.get("expiry") or "")
    ):
        return None
    return dict(payload)


def save_nine_twenty_anchor(path: Path, snapshot: Mapping[str, Any], reference: Mapping[str, Any]) -> None:
