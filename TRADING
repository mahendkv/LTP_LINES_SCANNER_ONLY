def compare_line_maps(
    calculated: Mapping[str, Any], observed: Mapping[str, Any], keys: Sequence[str]
) -> Dict[str, Any]:
    """Compare Python outputs with optional website observations without driving outputs."""
    rows: List[Dict[str, Any]] = []
    for key in keys:
        local_value = _js_parse_float(calculated.get(key))
        website_value = _js_parse_float(observed.get(key))
        if local_value is None or website_value is None:
            continue
        rows.append({
            "key": key, "python": local_value, "website": website_value,
            "difference": round(local_value - website_value, 4),
            "absolute_difference": round(abs(local_value - website_value), 4),
        })
    return {
        "available": bool(rows),
        "compared": len(rows),
        "max_absolute_difference": max((row["absolute_difference"] for row in rows), default=None),
        "mean_absolute_difference": (
            round(sum(row["absolute_difference"] for row in rows) / len(rows), 4) if rows else None
        ),
        "rows": rows,
    }


def website_comparison_summary(comparison: Mapping[str, Any]) -> str:
    if not comparison or not any((comparison.get(name) or {}).get("available") for name in ("live", "ai_ltp", "weekly")):
        return "OPTIONAL WEBSITE CHECK NOT RUN - PYTHON CALCULATIONS ACTIVE"
    parts = []
    for name, label in (("live", "LIVE"), ("ai_ltp", "AI"), ("weekly", "WEEKLY")):
        result = comparison.get(name) or {}
        if result.get("available"):
            parts.append(f"{label} {int(result.get('compared') or 0)} checked; max diff {sf(result.get('max_absolute_difference')):.2f}")
    return " | ".join(parts)


def _numeric_export_map(value: Any) -> Dict[str, float]:
    output: Dict[str, float] = {}
    for part in str(value or "").split("|"):
        if "=" not in part:
            continue
        key, raw = (item.strip() for item in part.split("=", 1))
        parsed = _js_parse_float(raw)
        if key and parsed is not None and parsed > 0 and math.isfinite(parsed):
            output[key] = float(parsed)
    return output


def build_parity_safety_gate(reference: Mapping[str, Any]) -> Dict[str, Any]:
    """Fail closed for missing core lines or observed drift beyond one tick.

    Conditional AI/D lines are validated against their current visibility count;
    they are not incorrectly required when the website rules say they are hidden.
    """
    live = {key: _js_parse_float((reference.get("live_magical_lines") or {}).get(key)) for key in LIVE_SIX_TV_EXPORT_KEYS}
    weekly = {key: _js_parse_float((reference.get("weekly_range") or {}).get(key)) for key in WEEKLY_TV_EXPORT_KEYS}
    nine_state = (reference.get("nine_twenty_strategy") or {}).get("line_state") or {}
    nine_value_source = str((reference.get("nine_twenty_strategy") or {}).get("value_source") or "")
    nine_twenty_frozen = nine_value_source in {
        "PYTHON_CALCULATED_NSE_OPTION_CHAIN", "SAVED_09_20_VALUES",
    }
    nine = {
        key: _js_parse_float((nine_state.get(key) or {}).get("value"))
        if (nine_state.get(key) or {}).get("current_numeric") else None
        for key in NINE_TWENTY_TV_EXPORT_KEYS
    }
    dominance = reference.get("dominance_lines") or {}
    dominance_keys = ("R_EXT", "R_DIV", "S_DIV", "S_EXT", "max_pain", "max_pain_top", "max_pain_bot")
    dominance_values = {key: _js_parse_float(dominance.get(key)) for key in dominance_keys}

    missing = {
        "live": [key for key, value in live.items() if value is None or value <= 0],
        "nine_twenty": [key for key, value in nine.items() if value is None or value <= 0],
        "weekly": [key for key, value in weekly.items() if value is None or value <= 0],
        "dominance": [key for key, value in dominance_values.items() if value is None or value <= 0],
    }
    family_status = reference.get("line_family_status") or {}
    ai_export = _numeric_export_map(reference.get("magical_tv_export"))
    d_export = _numeric_export_map(reference.get("d_overlay_tv_export"))
    conditional_checks = {
        "ai_ltp": {
            "expected_current_numeric": int(sf((family_status.get("ai_ltp") or {}).get("current_numeric"))),
            "exported_numeric": len(ai_export),
        },
        "d_overlays": {
            "expected_current_numeric": int(sf((family_status.get("d_overlays") or {}).get("current_numeric"))),
            "exported_numeric": len(d_export),
        },
    }
    conditional_count_ok = all(
        item["expected_current_numeric"] == item["exported_numeric"]
        for item in conditional_checks.values()
    )

    comparison = reference.get("website_comparison") or {}
    drift_rows: List[Dict[str, Any]] = []
    compared = 0
    for family in ("live", "ai_ltp", "weekly"):
        result = comparison.get(family) or {}
        compared += int(result.get("compared") or 0)
        for row in result.get("rows") or ():
            difference = sf(row.get("absolute_difference"))
            if difference > PARITY_TOLERANCE_POINTS + 1e-9:
                drift_rows.append({"family": family, **dict(row)})

    scenario_number = int(sf((reference.get("coa") or {}).get("scenario_number")))
    scenario_ok = scenario_number in PARITY_GATE_EVIDENCE["scenario_coverage"]
    core_complete = (
        not any(missing[family] for family in ("live", "nine_twenty", "weekly", "dominance"))
        and scenario_ok and nine_twenty_frozen
    )
    if drift_rows:
        status = "BLOCKED_RUNTIME_PARITY_DRIFT"
    elif not conditional_count_ok:
        status = "BLOCKED_CONDITIONAL_LINE_COUNT_MISMATCH"
    elif not nine_twenty_frozen:
        status = "BLOCKED_09_20_NOT_FROZEN"
    elif not core_complete:
        status = "BLOCKED_MISSING_REQUIRED_LINES"
    elif compared:
