        return enriched

    def website_nine_twenty_anchor(
        self, snapshot: Mapping[str, Any], auth_token: str
    ) -> Optional[Dict[str, Any]]:
        """Fetch the website's historical 09:20 snapshot when local capture is absent."""
        token = str(auth_token or "").strip()
        if not token or str(snapshot.get("symbol") or "").upper() not in INTRADAY_HISTORY_SYMBOLS:
            return None
        source_stamp = str(snapshot.get("website_fetch_time") or snapshot.get("market_timestamp") or "").strip()
        date_token = source_stamp.split(" ", 1)[0]
        if not date_token:
            return None
        try:
            response = self.website.get(
                "https://apiplatform.ltpcalculator.com/optionChain/fetch-data-by-fetchTime",
                params={
                    "symbol": snapshot.get("symbol"),
                    "expiry": self._website_expiry(snapshot.get("expiry")),
                    "lotSize": int(sf(snapshot.get("lot_size"))),
                    "fetchTime": f"{date_token} 09:20",
                },
                headers={"Authorization": f"Bearer {token}"}, timeout=self.timeout,
            )
            response.raise_for_status()
            payload = response.json()
            if not isinstance(payload, Mapping):
                return None
            native_rows = website_payload_to_full_rows(payload)
            native_status = website_rs_status(payload)
            if not native_rows or not native_status:
                return None
            anchored = dict(snapshot)
            anchored["full_rows"] = native_rows
            anchored["spot"] = sf(payload.get("Price_S")) or sf(snapshot.get("spot"))
            strikes = [sf(row.get("strikePrice")) for row in native_rows]
            anchored["step"] = calc_strike_gap(strikes) or sf(snapshot.get("step"))
            anchored["atm"] = min(strikes, key=lambda strike: abs(strike - anchored["spot"]))
            window = max(1, (len(snapshot.get("display_rows") or ()) - 1) // 2)
            atm_index = strikes.index(anchored["atm"])
            anchored["display_rows"] = native_rows[
                max(0, atm_index-window):min(len(native_rows), atm_index+window+1)
            ]
            anchored["website_rs_status"] = native_status
            anchored["reversal_model"] = website_reversal_model(payload)
            anchored["website_native_status"] = "WEBSITE_NATIVE_EXACT_FIELDS"
            anchored["website_fetch_time"] = str(payload.get("FetchTime") or f"{date_token} 09:20:00")
            anchored["market_timestamp"] = anchored["website_fetch_time"]
            return anchored
        except Exception:
            return None

