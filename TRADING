def sf(value: Any, default: float = 0.0) -> float:
    try:
        out = float(value)
        return out if math.isfinite(out) else default
    except Exception:
        return default


def fmt_big(value: Any) -> str:
    n = sf(value)
    a = abs(n)
    if a >= 10_000_000:
        return f"{n / 10_000_000:.2f}Cr"
    if a >= 100_000:
        return f"{n / 100_000:.2f}L"
    if a >= 1_000:
        return f"{n / 1_000:.2f}k"
    return str(int(n))


def fmt_indian(value: Any) -> str:
    """Match the website's formatIndianNumber output for chain integer fields."""
    n = int(sf(value))
    sign = "-" if n < 0 else ""
    digits = str(abs(n))
    if len(digits) <= 3:
        return sign + digits
    tail = digits[-3:]
    head = digits[:-3]
    groups: List[str] = []
    while len(head) > 2:
        groups.append(head[-2:])
        head = head[:-2]
    if head:
        groups.append(head)
    return sign + ",".join(reversed(groups)) + "," + tail


_CHAIN_FIELDS = ("openInterest", "changeinOpenInterest", "totalTradedVolume")


def website_chain_rankings(rows: Sequence[Mapping[str, Any]]) -> Dict[str, Dict[str, float]]:
    """Reproduce the website bundle's Bu() ranking helper on displayed rows."""
    rankings: Dict[str, Dict[str, float]] = {}
    for side in ("CE", "PE"):
        for field in _CHAIN_FIELDS:
            ordered = sorted((_opt(row, side, field) for row in rows), reverse=True)
            if not ordered:
                highest = actual_second = lowest = second = 0.0
            else:
                highest = ordered[0]
                actual_second = ordered[1] if len(ordered) > 1 else highest
                lowest = ordered[-1]
                second = actual_second
                if highest == 0.0:
                    ratio = math.nan if actual_second == 0.0 else math.copysign(math.inf, actual_second)
                else:
                    ratio = actual_second / highest
                if ratio <= 0.75:
                    second = float(math.ceil(highest * 0.75) + 1)
            rankings[f"{side}_{field}"] = {
                "highest": highest,
                "second": second,
                "actual_second": actual_second,
                "lowest": lowest,
            }
    return rankings


def website_chain_fill_name(
    side: str,
    field: str,
    value: Any,
    strike: Any,
    spot: Any,
    rankings: Mapping[str, Mapping[str, float]],
) -> str:
    """Return the Excel fill matching the website's ordered backgroundColor expression."""
    raw = sf(value)
    rank = rankings[f"{side}_{field}"]
    highest, second, lowest = rank["highest"], rank["second"], rank["lowest"]
    if field == "totalTradedVolume":
        if raw == highest:
            return "website_volume_high"
        if raw == second:
            return "website_second"
    elif side == "CE" and field == "openInterest":
        if raw == highest:
            return "website_pink"
        if raw == second:
            return "website_second"
        if raw == lowest:
            return "website_green"
    elif side == "PE" and field == "openInterest":
        if raw == highest:
            return "website_green"
        if raw == second:
            return "website_second"
        if raw == lowest:
            return "website_pink"
    elif side == "CE" and field == "changeinOpenInterest":
        # The website checks CE lowest before CE highest.
        if raw == lowest:
            return "website_green"
        if raw == highest:
            return "website_pink"
    elif side == "PE" and field == "changeinOpenInterest":
        # The website checks PE lowest before PE highest.
        if raw == lowest:
            return "website_pink"
        if raw == highest:
            return "website_green"
    if (side == "CE" and sf(spot) >= sf(strike)) or (side == "PE" and sf(spot) < sf(strike)):
        return "website_gray"
    return "white"


def website_chain_bold(side: str, field: str, value: Any, rankings: Mapping[str, Mapping[str, float]]) -> bool:
    """Match outer ranked bolding plus the website's >75% inner text weight."""
    raw = sf(value)
    rank = rankings[f"{side}_{field}"]
    ranked = field in ("openInterest", "totalTradedVolume") and raw in (rank["highest"], rank["second"])
    maximum = rank["highest"]
    percentage_bold = maximum != 0.0 and raw / maximum * 100.0 > 75.0
    return bool(ranked or percentage_bold)


def strike_key(value: Any) -> Any:
    v = sf(value)
    return int(round(v)) if abs(v - round(v)) < 1e-9 else round(v, 2)


def calc_strike_gap(strikes: Iterable[Any]) -> float:
    values = sorted({sf(x) for x in strikes if sf(x) > 0})
    diffs = [round(b - a, 8) for a, b in zip(values, values[1:]) if b > a]
    return max(set(diffs), key=diffs.count) if diffs else 0.0


def parse_expiry(value: Any) -> Optional[datetime]:
    text = str(value or "").strip()
    for fmt in ("%d-%b-%Y", "%d-%B-%Y", "%Y-%m-%d", "%d/%m/%Y", "%d-%m-%Y"):
        try:
            return datetime.strptime(text, fmt)
        except ValueError:
            pass
    return None


def time_to_expiry_years(expiry: Any, now: Optional[datetime] = None) -> float:
    parsed = parse_expiry(expiry)
    if parsed is None:
        return SREV_MIN_T_YEARS
    expiry_dt = datetime.combine(parsed.date(), dtime(hour=15, minute=30))
    seconds = max(0.0, (expiry_dt - (now or datetime.now())).total_seconds())
    return max(seconds / (365.0 * 86400.0), SREV_MIN_T_YEARS)


def snapshot_time_to_expiry_years(expiry: Any, market_timestamp: Any) -> float:
    """Use the exchange snapshot clock so frozen quotes do not decay after hours."""
    text = str(market_timestamp or "").strip()
    for fmt in (
        "%d-%b-%Y %H:%M:%S", "%d-%m-%Y %H:%M:%S",
        "%Y-%m-%d %H:%M:%S", "%Y-%m-%dT%H:%M:%S",
    ):
        try:
            return time_to_expiry_years(expiry, datetime.strptime(text, fmt))
        except ValueError:
            pass
    return time_to_expiry_years(expiry)


def normal_cdf(x: float) -> float:
    return (1.0 + math.erf(x / math.sqrt(2.0))) / 2.0


def calc_delta(spot: Any, strike: Any, t_years: Any, iv: Any, is_call: bool) -> float:
    s, k = sf(spot), sf(strike)
    t = max(sf(t_years), SREV_MIN_T_YEARS)
    sigma = sf(iv)
    if sigma > 1.0:
        sigma /= 100.0
    if s <= 0 or k <= 0 or sigma <= 0:
        return 0.0
    try:
        d1 = (math.log(s / k) + (RISK_FREE - DIV_YIELD + 0.5 * sigma * sigma) * t) / (sigma * math.sqrt(t))
        if is_call:
            return math.exp(-DIV_YIELD * t) * normal_cdf(d1)
        return math.exp(-DIV_YIELD * t) * (normal_cdf(d1) - 1.0)
    except Exception:
        return 0.0


def calc_gamma(spot: Any, strike: Any, t_years: Any, iv: Any) -> float:
    s, k = sf(spot), sf(strike)
    t = max(sf(t_years), SREV_MIN_T_YEARS)
    sigma = sf(iv)
    if sigma > 1.0:
        sigma /= 100.0
    if s <= 0 or k <= 0 or sigma <= 0:
        return 0.0
    try:
        d1 = (math.log(s / k) + (RISK_FREE - DIV_YIELD + 0.5 * sigma * sigma) * t) / (sigma * math.sqrt(t))
        pdf = math.exp(-0.5 * d1 * d1) / math.sqrt(2.0 * math.pi)
        return math.exp(-DIV_YIELD * t) * pdf / (s * sigma * math.sqrt(t))
    except Exception:
        return 0.0


def csv_rows_to_full_rows(rows: Sequence[Mapping[str, Any]]) -> List[Dict[str, Any]]:
    full: List[Dict[str, Any]] = []
    for row in rows:
        strike = sf(row.get("strike") or row.get("strikePrice"))
        if strike <= 0:
            continue
        converted = {
            "strikePrice": strike,
            "CE": {
                "lastPrice": sf(row.get("ce_ltp")),
                "change": sf(row.get("ce_change") or row.get("ce_ltp_change")),
                "impliedVolatility": sf(row.get("ce_iv")),
                "openInterest": sf(row.get("ce_oi")),
                "changeinOpenInterest": sf(row.get("ce_oichg")),
                "totalTradedVolume": sf(row.get("ce_vol") or row.get("ce_volume")),
            },
            "PE": {
                "lastPrice": sf(row.get("pe_ltp")),
                "change": sf(row.get("pe_change") or row.get("pe_ltp_change")),
                "impliedVolatility": sf(row.get("pe_iv")),
                "openInterest": sf(row.get("pe_oi")),
                "changeinOpenInterest": sf(row.get("pe_oichg")),
                "totalTradedVolume": sf(row.get("pe_vol") or row.get("pe_volume")),
            },
        }
        ce_delta = sf(row.get("ce_delta") or row.get("cdelta"))
        ce_gamma = sf(row.get("ce_gamma") or row.get("cgamma"))
        pe_delta = sf(row.get("pe_delta") or row.get("pdelta"))
        pe_gamma = sf(row.get("pe_gamma") or row.get("pgamma"))
        if ce_delta != 0.0 or ce_gamma != 0.0:
            converted["CE"]["delta"] = ce_delta
            converted["CE"]["gamma"] = ce_gamma
        if pe_delta != 0.0 or pe_gamma != 0.0:
            converted["PE"]["delta"] = pe_delta
            converted["PE"]["gamma"] = pe_gamma
        ce_native = sf(row.get("calReversal") or row.get("callReversal") or row.get("ce_sreversal"))
        pe_native = sf(row.get("putReversal") or row.get("peReversal") or row.get("pe_sreversal"))
        if ce_native > 0.0:
            converted["calReversal"] = ce_native
        if pe_native > 0.0:
            converted["putReversal"] = pe_native
        full.append(converted)
    return sorted(full, key=lambda r: sf(r["strikePrice"]))


