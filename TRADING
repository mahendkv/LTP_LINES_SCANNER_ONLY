def _number(value: Any, default: float = 0.0) -> float:
    try:
        if isinstance(value, str):
            match = re.search(r"[-+]?(?:\d+(?:\.\d*)?|\.\d+)", value.replace(",", ""))
            value = match.group(0) if match else value
        result = float(value)
        return result if math.isfinite(result) else default
    except (TypeError, ValueError):
        return default


def _key(value: Any) -> Any:
    value = _number(value)
    rounded = round(value)
    return int(rounded) if abs(value - rounded) < 1e-9 else round(value, 8)


def _nearest(rows: Sequence[Mapping[str, Any]], target: Any) -> Any:
    strikes = sorted({_number(row.get("strikePrice")) for row in rows if _number(row.get("strikePrice")) > 0})
    if not strikes:
        return 0
    answer = min(strikes, key=lambda strike: (abs(strike - _number(target)), strike))
    return _key(answer)


def _display(side: str, spot: Any, value: Any) -> Any:
    numeric, current = _number(value), _number(spot)
    if numeric <= 0:
        return "NA"
    if side.upper() == "CE" and current >= numeric:
        return "Break Out"
    if side.upper() == "PE" and current <= numeric:
        return "Break Down"
    return numeric


def _native_reversal_model(payload: Optional[Mapping[str, Any]]) -> Dict[str, Any]:
    if not payload:
        return {}
    candidate: Mapping[str, Any] = payload
    for key in ("reversalModel", "reversal_model"):
        nested = payload.get(key)
        if isinstance(nested, Mapping):
            candidate = nested
            break
    return {field: candidate[field] for field in REVERSAL_FIELDS if field in candidate}


def build_stock_reversal_model(
    full_rows: Sequence[Mapping[str, Any]],
    spot: Any,
    step: Any,
    ce_sreversal: Mapping[Any, Any],
    pe_sreversal: Mapping[Any, Any],
    ladder: Mapping[str, Any],
    native_payload: Optional[Mapping[str, Any]] = None,
) -> Tuple[Dict[str, Any], Dict[str, Any]]:
    """Return the eight stock reversal fields without touching index logic.

    Native website fields win field-by-field. Missing fields use the observed
    STRONG/WTT/WTB strike mapping, evaluated against S-Reversal prices.
    """
    rows, current, gap = list(full_rows), _number(spot), _number(step)
    if not rows:
        raise ValueError("Option-chain rows are empty")
    if gap <= 0:
        strikes = sorted({_number(row.get("strikePrice")) for row in rows})
        gaps = [b - a for a, b in zip(strikes, strikes[1:]) if b > a]
        gap = min(gaps) if gaps else 1.0
    resistance, support = dict(ladder.get("R") or {}), dict(ladder.get("S") or {})
    fallback = _nearest(rows, current)
    r_base = _nearest(rows, resistance.get("strike")) if _number(resistance.get("strike")) > 0 else fallback
    s_base = _nearest(rows, support.get("strike")) if _number(support.get("strike")) > 0 else fallback
    r_shift = _nearest(rows, resistance.get("shifting_strike")) if _number(resistance.get("shifting_strike")) > 0 else r_base
    r_state = str(resistance.get("trade_status") or "STRONG").upper()
    scenario_number = infer_reversal_model_scenario(ladder, current, gap)
    s_oi_leader = _number((support.get("oi") or {}).get("strike")) or _number(s_base)
    s_vol_leader = _number((support.get("vol") or {}).get("strike")) or _number(s_base)
    s_shift = _nearest(rows, support.get("shifting_strike")) if _number(support.get("shifting_strike")) > 0 else s_base

    def strike(base: Any, offset: int) -> Any:
        return _nearest(rows, _number(base) + offset * gap)

    if scenario_number == 8:
        selections = {
            "riskyResistance": ("CE", r_base), "moderateResistance": (None, None),
            "resistanceSL": ("CE", r_shift), "resistanceTarget": ("PE", r_base),
            "riskySupport": ("PE", r_base), "moderateSupport": (None, None),
            "supportSL": ("PE", s_oi_leader), "supportTarget": ("CE", r_base),
        }
    elif scenario_number == 9 and r_state == "STRONG":
        risky_r = _nearest(rows, (resistance.get("oi") or {}).get("shifting_strike"))
        risky_r = risky_r if _number(risky_r) > 0 else strike(r_base, -1)
        support_risky = strike(s_base, 1)
        selections = {
            "riskyResistance": ("CE", risky_r), "moderateResistance": ("CE", r_base),
            "resistanceSL": ("CE", strike(r_base, 2)), "resistanceTarget": ("PE", support_risky),
            "riskySupport": ("PE", support_risky), "moderateSupport": ("PE", s_base),
            "supportSL": ("PE", s_vol_leader), "supportTarget": ("CE", risky_r),
        }
    elif r_state == "WTT":
        selections = {
            "riskyResistance": (None, None), "moderateResistance": (None, None),
            "resistanceSL": (None, None), "resistanceTarget": (None, None),
            "riskySupport": ("PE", s_base), "moderateSupport": ("PE", strike(s_base, -1)),
            "supportSL": ("PE", strike(s_base, -2)),
            "supportTarget": ("CE", r_shift if _number(r_shift) > _number(r_base) else strike(r_base, 1)),
        }
    elif r_state == "WTB":
        selections = {
            "riskyResistance": ("CE", r_shift), "moderateResistance": ("CE", r_base),
            "resistanceSL": ("CE", strike(r_base, 2)), "resistanceTarget": ("PE", r_shift),
            "riskySupport": ("PE", strike(s_base, -1)), "moderateSupport": (None, None),
            "supportSL": ("PE", strike(s_base, -2)), "supportTarget": ("CE", s_base),
        }
    else:
        selections = {
            "riskyResistance": ("CE", r_base), "moderateResistance": ("CE", strike(r_base, 1)),
            "resistanceSL": ("CE", strike(r_base, 2)), "resistanceTarget": ("PE", r_base),
            "riskySupport": ("PE", strike(s_base, -1)), "moderateSupport": (None, None),
            "supportSL": ("PE", strike(s_base, -2)), "supportTarget": ("CE", s_base),
        }

    reconstructed: Dict[str, Any] = {}
    for field, (side, source_strike) in selections.items():
        if side is None:
            reconstructed[field] = "NA"
            continue
        source = ce_sreversal if side == "CE" else pe_sreversal
        reconstructed[field] = _display(side, current, source.get(_key(source_strike)))

    native = _native_reversal_model(native_payload)
    model = dict(reconstructed)
    model.update(native)
    exact = len(native) == len(REVERSAL_FIELDS)
    debug = {
        "module_version": STOCK_LINES_VERSION,
        "source": "NATIVE_WEBSITE_REVERSAL_MODEL" if exact else (
            "NATIVE_WITH_LOCAL_STOCK_FALLBACK" if native else "LOCAL_STOCK_CONDITIONAL_RECONSTRUCTION"
        ),
        "exact_website_parity": exact,
        "condition": r_state,
        "scenario_number": scenario_number,
        "resistance_strike": r_base,
        "resistance_shifting_strike": r_shift,
        "support_strike": s_base,
        "native_fields": sorted(native),
        "source_strikes": {field: source_strike for field, (_, source_strike) in selections.items()},
        "important_limit": (
            "Exact parity requires the native website reversalModel. The public JavaScript renders these fields "
            "but does not disclose the backend formula."
        ),
    }
    return model, debug


def _first_report_row(payload: Any, symbol: Optional[str] = None) -> Dict[str, Any]:
    rows = payload if isinstance(payload, list) else payload.get("data", payload) if isinstance(payload, Mapping) else []
    if isinstance(rows, Mapping):
        rows = [rows]
    if not isinstance(rows, list):
        return {}
    wanted = str(symbol or "").upper().strip()
    for row in rows:
        if isinstance(row, Mapping) and (not wanted or str(row.get("symbol") or "").upper() == wanted):
            return dict(row)
    return {}


def build_stock_entry_lines(payload: Any, symbol: Optional[str] = None) -> Dict[str, Any]:
    """Parse the website's native iDaddy stock row and reproduce chart labels."""
    row = _first_report_row(payload, symbol)
    pv = _number(row.get("strikeDifference")) / 2.0
    definitions = (
        ("C1", "callEntry1", "green"), ("C2", "callEntry2", "green"),
        ("P1", "putEntry1", "red"), ("P2", "putEntry2", "red"),
    )
    lines = []
    for key, field, color in definitions:
        price = _number(row.get(field))
        if price <= 0:
            continue
        if key.startswith("C"):
            max_gain, max_pain = price + pv, price - 1.2 * pv
        else:
            max_gain, max_pain = price - pv, price + 1.2 * pv
        lines.append({
            "key": key, "source_field": field, "raw": price, "price": price, "base_color": color,
            "line_style": "solid", "current_numeric": True, "visible": True,
            "max_gain": round(max_gain, 2), "max_pain": round(max_pain, 2),
            "title": f"Max Gain {max_gain:.1f} | Max Pain {max_pain:.1f} | {key}",
        })
    return {
        "module_version": STOCK_LINES_VERSION,
        "source": "NATIVE_WEBSITE_IDADDY_BLAST" if lines else "NATIVE_STOCK_REPORT_NOT_SUPPLIED",
        "exact_website_parity": bool(lines),
        "symbol": str(row.get("symbol") or symbol or "").upper(),
        "point_value": pv,
        "bullish_risk": row.get("callRating", "NA"),
        "bearish_risk": row.get("putRating", "NA"),
        "website_spot": _number(row.get("priceS")),
        "lines": lines,
        "important_limit": "C1/C2/P1/P2 are server-supplied; they are not derived from the public option-chain bundle.",
    }


def load_stock_report(path: Path) -> Any:
    return json.loads(Path(path).read_text(encoding="utf-8-sig"))


def fetch_stock_report(symbol: str, fetch_date: str, auth_token: str, timeout: float = 15.0) -> Any:
    """Fetch the same authenticated stock-report endpoint used by the website."""
    if not str(auth_token or "").strip():
        raise ValueError("An LTP Calculator auth token is required")
    query = urllib.parse.urlencode({"fetchDate": fetch_date, "symbol": str(symbol).upper()})
    request = urllib.request.Request(
        "https://apiplatform.ltpcalculator.com/reports/idaddy-blast?" + query,
        headers={"Authorization": "Bearer " + str(auth_token).strip(), "Accept": "application/json"},
    )
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return json.loads(response.read().decode("utf-8"))




