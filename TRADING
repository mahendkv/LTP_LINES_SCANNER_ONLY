            previous = sf(quote.get("prev_close") or (preopen.get(symbol) or {}).get("prev_close"))
            low, high = sf(quote.get("low")), sf(quote.get("high"))
            if not low: low = min(value for value in (opening, ltp) if value) if opening or ltp else 0.0
            if not high: high = max(opening, ltp)
            rows.append(normalize_market_tracker_row({
                "symbol": symbol, "category": "STOCK", "lot": lots.get(symbol),
                "ltp": ltp, "open": opening, "prev_close": previous, "low": low, "high": high,
                "source": "NSE OPEN + YAHOO LIVE OHLC" if symbol in quotes else "NSE PRE-OPEN FALLBACK",
                "updated_at": quote.get("updated_at") or nse_timestamp,
            }))

        indices_payload = self._json("https://www.nseindia.com/api/allIndices") or {}
        by_name = {
            str(item.get("index") or "").upper(): item
            for item in indices_payload.get("data") or () if isinstance(item, Mapping)
        }
        for symbol, name in MARKET_TRACKER_INDEX_SYMBOLS.items():
            item = by_name.get(name.upper(), {})
            rows.append(normalize_market_tracker_row({
                "symbol": symbol, "category": "INDEX", "lot": lots.get(symbol),
                "ltp": item.get("last"), "open": item.get("open"), "prev_close": item.get("previousClose"),
                "low": item.get("low"), "high": item.get("high"),
                "source": "NSE ALL INDICES" if item else "NSE INDEX UNAVAILABLE",
                "updated_at": indices_payload.get("timestamp") or nse_timestamp,
            }))
        return sorted(rows, key=lambda row: (0 if row.get("category") == "INDEX" else 1, str(row.get("symbol"))))

