    def _market_tracker_yahoo_spark(self, symbols: Sequence[str]) -> Dict[str, Dict[str, Any]]:
        """Fetch live OHLC fields in batches; no LTP Calculator endpoint is used."""
        output: Dict[str, Dict[str, Any]] = {}
        headers = {"User-Agent": self.headers["User-Agent"], "Accept": "application/json"}
        # Yahoo's public Spark endpoint rejects more than 20 symbols.
        for offset in range(0, len(symbols), 20):
            batch = [f"{symbol}.NS" for symbol in symbols[offset:offset + 20]]
            try:
                response = self.requests.get(
                    "https://query1.finance.yahoo.com/v7/finance/spark",
                    params={"symbols": ",".join(batch), "range": "1d", "interval": "5m"},
                    headers=headers, timeout=max(self.timeout, 20.0),
                )
                response.raise_for_status()
                payload = response.json()
                for result in ((payload.get("spark") or {}).get("result") or ()):
                    responses = result.get("response") or ()
                    if not responses:
                        continue
                    meta = responses[0].get("meta") or {}
                    symbol = str(result.get("symbol") or meta.get("symbol") or "").removesuffix(".NS").upper()
                    if symbol:
                        output[symbol] = {
                            "ltp": sf(meta.get("regularMarketPrice") or meta.get("fulldayPrice")),
                            "prev_close": sf(meta.get("previousClose") or meta.get("chartPreviousClose")),
                            "low": sf(meta.get("regularMarketDayLow")),
                            "high": sf(meta.get("regularMarketDayHigh")),
                            "updated_at": datetime.fromtimestamp(
                                sf(meta.get("regularMarketTime")),
                            ).astimezone().isoformat(timespec="seconds") if sf(meta.get("regularMarketTime")) else "",
                        }
            except Exception:
                continue
        return output

    def market_tracker_snapshot(self, equity_symbols: Optional[Sequence[str]] = None) -> List[Dict[str, Any]]:
        """Build the website-like scanner from independent NSE/Yahoo market data."""
        equities = sorted(dict.fromkeys(str(symbol).upper().strip() for symbol in (equity_symbols or self.equity_symbols()) if str(symbol).strip()))
        lots = self.market_tracker_lot_sizes()
        preopen, nse_timestamp = self._market_tracker_preopen()
        quotes = self._market_tracker_yahoo_spark(equities)
        rows: List[Dict[str, Any]] = []
        for symbol in equities:
            quote = quotes.get(symbol, {})
            opening = sf((preopen.get(symbol) or {}).get("open"))
