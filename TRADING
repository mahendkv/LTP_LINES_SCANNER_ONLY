        "eor_display": website_coa_action_label(rule["eor_action"]),
        "scenario_display": (
            f"Scenario {rule['scenario_number']} — {rule['name']}: "
            f"Resistance {website_coa_state_label(resistance)}; "
            f"Support {website_coa_state_label(support)}"
        ),
        "rule_version": COA_RULE_VERSION,
        "source": "WEBSITE_COA_1_STATIC_NINE_SCENARIO_MATRIX",
