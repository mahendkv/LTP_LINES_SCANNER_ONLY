def _font(color: str = "black", bold: bool = False, size: int = 10):
    from openpyxl.styles import Font
    return Font(name="Aptos", size=size, color=COLORS[color], bold=bold)


def _fill(color: str):
    from openpyxl.styles import PatternFill
    return PatternFill("solid", fgColor=COLORS[color])


def _border():
    from openpyxl.styles import Border, Side
    side = Side(style="thin", color=COLORS["grid"])
    return Border(left=side, right=side, top=side, bottom=side)


def _style(cell: Any, fill: str = "white", font: str = "black", bold: bool = False, size: int = 10) -> None:
    from openpyxl.styles import Alignment
    cell.fill, cell.font, cell.border = _fill(fill), _font(font, bold, size), _border()
    cell.alignment = Alignment(horizontal="center", vertical="center", wrap_text=True)


def _merge_write(ws: Any, cell_range: str, value: Any, fill: str, font: str = "black", bold: bool = True, size: int = 10) -> None:
    ws.merge_cells(cell_range)
    cell = ws[cell_range.split(":")[0]]; cell.value = value
    for row in ws[cell_range]:
        for item in row: _style(item, fill, font, bold, size)



