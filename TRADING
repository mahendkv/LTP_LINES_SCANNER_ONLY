def build_reference_snapshot(
    csv_rows: Sequence[Mapping[str, Any]],
    symbol: Optional[str] = None,
    expiry: Optional[str] = None,
    stock_report: Any = None,
) -> Dict[str, Any]:
    """Pure calculation API. It has no side effects and contains no trading output."""
    if not csv_rows: raise ValueError("Option-chain rows are empty")
    csv_rows = latest_snapshot_rows(csv_rows)
    if not csv_rows: raise ValueError("No timestamped option-chain snapshot was found")
    first = csv_rows[0]
    sym = str(symbol or first.get("symbol") or "NIFTY").upper().strip()
    exp = str(expiry or first.get("expiry") or "").strip()
    spot = sf(first.get("spot"))
    full_rows = csv_rows_to_full_rows(csv_rows)
    step = calc_strike_gap(r.get("strikePrice") for r in full_rows) or sf(INDEX_CONFIG.get(sym, {}).get("step"), 50.0)
    atm = nearest_strike(full_rows, spot)
    snapshot_time = parsed_market_timestamp(first)
    snapshot_t = time_to_expiry_years(exp, snapshot_time) if snapshot_time != datetime.min else None
    bundle = build_canonical_bundle(
        full_rows, spot, atm, step, exp, t_years=snapshot_t,
        plot_state_key=f"{sym}|{exp}",
        observation_id=str(first.get("timestamp") or first.get("market_timestamp") or ""),
        instrument_kind="INDEX" if sym in INDEX_CONFIG else "EQUITY",
        stock_report=stock_report,
    )
    reference = {
        "reference_version": REFERENCE_VERSION, "reference_source": REFERENCE_SOURCE,
        "generated_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "symbol": sym, "expiry": exp, "spot": spot, "step": step, "atm": sf(atm),
        **bundle,
    }
    reference["parity_safety_gate"] = build_parity_safety_gate(reference)
    return reference


# ---- Independent market tracker (display only) ---------------------------
def market_tracker_day_range(ltp: Any, low: Any, high: Any) -> Optional[float]:
    """Mirror the website's ((C-L)/(H-L))*100 calculation."""
    close, lo, hi = sf(ltp), sf(low), sf(high)
    if hi == lo or not all(math.isfinite(value) for value in (close, lo, hi)):
        return None
    return round((close - lo) / (hi - lo) * 100.0, 2)


def market_tracker_open_condition(open_price: Any, low: Any, high: Any) -> str:
    """Mirror the website's strict O===H / O===L filters."""
    opened, lo, hi = sf(open_price), sf(low), sf(high)
    if opened == hi and opened == lo and opened != 0:
        return "OPEN = HIGH = LOW"
    if opened == hi and opened != 0:
        return "OPEN = HIGH"
    if opened == lo and opened != 0:
        return "OPEN = LOW"
    return "-"


def local_market_tracker_result(change_pct: Any, day_range: Any) -> str:
    """Transparent price-only regime; never represented as proprietary COA."""
    change = sf(change_pct)
    position = sf(day_range, 50.0)
    if change >= 1.0 and position >= 70.0:
        return "PRICE BULL RUN"
    if change <= -1.0 and position <= 30.0:
        return "PRICE BLOOD BATH"
    if change > 0.15:
        return "PRICE SLIGHT BULLISH"
    if change < -0.15:
        return "PRICE SLIGHT BEARISH"
    return "PRICE NEUTRAL"


def parse_market_tracker_ohlc(value: Any) -> Dict[str, float]:
    """Parse the website price-ticker OHLC object/string without needing the site.

    The website currently supplies ``spot_ohlc_data`` either as an object or as
    JSON text with O/H/L/C and pclose keys.  Keeping this parser pure makes saved
    website fixtures replayable while production scanning can remain independent.
    """
    payload: Any = value
    if isinstance(value, str):
        try:
            payload = json.loads(value)
        except (TypeError, ValueError, json.JSONDecodeError):
            payload = {}
    if not isinstance(payload, Mapping):
        payload = {}
    return {
        "open": sf(payload.get("O") if payload.get("O") is not None else payload.get("open")),
        "high": sf(payload.get("H") if payload.get("H") is not None else payload.get("high")),
        "low": sf(payload.get("L") if payload.get("L") is not None else payload.get("low")),
        "ltp": sf(payload.get("C") if payload.get("C") is not None else payload.get("close")),
        "prev_close": sf(
            payload.get("pclose") if payload.get("pclose") is not None
            else payload.get("previousClose")
        ),
    }


def website_market_tracker_row(item: Mapping[str, Any]) -> Dict[str, Any]:
    """Normalize one saved ``price-tickers`` item exactly like Market Tracker.

    ``marketDirection`` is copied, never inferred.  When it is absent the row is
    explicitly marked unavailable instead of silently substituting a price rule.
    """
    details = item.get("details") if isinstance(item.get("details"), Mapping) else item
    direction = details.get("symbolMarketDirection") if isinstance(details, Mapping) else {}
    if not isinstance(direction, Mapping):
        direction = {}
    ohlc = parse_market_tracker_ohlc(
        item.get("spot_ohlc_data") if item.get("spot_ohlc_data") is not None
        else details.get("spot_ohlc_data") if isinstance(details, Mapping) else None
    )
    symbol = str(
        details.get("symbol") if isinstance(details, Mapping) else ""
        or item.get("symbol") or item.get("ticker") or ""
    ).upper().strip()
    category = str(details.get("category") if isinstance(details, Mapping) else item.get("category") or "STOCK").upper()
    return normalize_market_tracker_row({
        "symbol": symbol,
        "category": "INDEX" if category == "INDEX" else "STOCK",
        "lot": details.get("lot") if isinstance(details, Mapping) else item.get("lot"),
        **ohlc,
        "market_result": str(direction.get("marketDirection") or "WEBSITE STATUS UNAVAILABLE"),
        "source": "SAVED WEBSITE PRICE-TICKER PAYLOAD",
        "updated_at": str(item.get("updatedAt") or item.get("timestamp") or ""),
    })


def website_market_tracker_rows(payload: Any) -> List[Dict[str, Any]]:
    """Convert a saved website response (list or common wrapper) to scanner rows."""
    data = payload
    if isinstance(payload, Mapping):
        for key in ("data", "result", "content", "priceTickers"):
            if isinstance(payload.get(key), list):
                data = payload[key]
                break
    if not isinstance(data, list):
        return []
    return [website_market_tracker_row(item) for item in data if isinstance(item, Mapping)]


def filter_market_tracker_rows(
    rows: Sequence[Mapping[str, Any]], search: str = "", category: str = "ALL",
    open_filter: str = "ALL",
) -> List[Dict[str, Any]]:
    """Mirror the website search/category/open filters using exact equality."""
    needle = str(search or "").upper().strip()
    category_key = str(category or "ALL").upper().strip()
    open_key = str(open_filter or "ALL").upper().replace(" ", "")
    output: List[Dict[str, Any]] = []
    for raw in rows:
        row = normalize_market_tracker_row(raw)
        if needle and needle not in row["symbol"]:
            continue
        is_index = row["category"] == "INDEX"
        if category_key == "INDEX" and not is_index:
            continue
        if category_key in ("STOCK", "STOCKS", "EQUITY", "EQ") and is_index:
            continue
        if open_key in ("OPEN=HIGH", "HIGH") and sf(row["open"]) != sf(row["high"]):
            continue
        if open_key in ("OPEN=LOW", "LOW", "LOW=HIGH") and sf(row["open"]) != sf(row["low"]):
            continue
        output.append(row)
    return output


def normalize_market_tracker_row(row: Mapping[str, Any]) -> Dict[str, Any]:
    normalized = dict(row)
    ltp, opened = sf(row.get("ltp")), sf(row.get("open"))
    previous, low, high = sf(row.get("prev_close")), sf(row.get("low")), sf(row.get("high"))
    change = ltp - previous if ltp and previous else sf(row.get("change"))
    change_pct = change / previous * 100.0 if previous else sf(row.get("change_pct"))
    day_range = market_tracker_day_range(ltp, low, high)
    normalized.update({
        "symbol": str(row.get("symbol") or "").upper().strip(),
        "category": str(row.get("category") or "STOCK").upper(),
        "lot": int(sf(row.get("lot"))) if sf(row.get("lot")) else "NA",
        "ltp": round(ltp, 2), "open": round(opened, 2),
        "prev_close": round(previous, 2), "low": round(low, 2), "high": round(high, 2),
        "day_range": day_range, "change": round(change, 2), "change_pct": round(change_pct, 2),
        "open_condition": market_tracker_open_condition(opened, low, high),
        "market_result": str(row.get("market_result") or local_market_tracker_result(change_pct, day_range)),
        "source": str(row.get("source") or "INDEPENDENT MARKET DATA"),
        "updated_at": str(row.get("updated_at") or ""),
    })
    return normalized


def market_tracker_excel_rows(rows: Sequence[Mapping[str, Any]]) -> List[List[Any]]:
    output: List[List[Any]] = []
    for raw in rows:
        row = normalize_market_tracker_row(raw)
        output.append([
            row["symbol"], row["lot"], row["ltp"], row["market_result"],
            row["open"], row["prev_close"],
            row["day_range"] if row["day_range"] is not None else "NA", row["change"],
            row["category"], row["low"], row["high"], row["change_pct"],
            row["open_condition"], row["source"], row["updated_at"],
        ])
    return output


