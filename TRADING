def read_csv(path: Path) -> List[Dict[str, str]]:
    with Path(path).open("r", newline="", encoding="utf-8-sig") as handle:
        return list(csv.DictReader(handle))


def read_first_csv_row(path: Path) -> Dict[str, str]:
    with Path(path).open("r", newline="", encoding="utf-8-sig") as handle:
        return next(csv.DictReader(handle), {})


def latest_csv(data_dir: Path, symbol: str) -> Path:
    files = sorted(Path(data_dir).glob(f"{symbol.upper()}_FULLCHAIN_*.csv"), key=lambda p: p.stat().st_mtime, reverse=True)
    if not files: raise FileNotFoundError(f"No {symbol} FULLCHAIN CSV in {data_dir}")
    return files[0]


def select_expiry_csv(data_dir: Path, symbol: str, requested: Any = "NEAREST") -> Path:
    files = sorted(
        Path(data_dir).glob(f"{symbol.upper()}_FULLCHAIN_*.csv"),
        key=lambda p: p.stat().st_mtime,
        reverse=True,
    )
    if not files:
        raise FileNotFoundError(f"No {symbol} FULLCHAIN CSV in {data_dir}")
    by_expiry: Dict[str, List[Path]] = {}
    for path in files:
        expiry = str(read_first_csv_row(path).get("expiry") or "").strip()
        if expiry:
            by_expiry.setdefault(expiry, []).append(path)
    text = str(requested or "NEAREST").strip()
    parsed = parse_expiry(text)
    if parsed:
        matches = [p for expiry, paths in by_expiry.items() if parse_expiry(expiry) and parse_expiry(expiry).date() == parsed.date() for p in paths]
        if not matches:
            raise FileNotFoundError(
                f"Expiry {text!r} is not downloaded for {symbol}. Available: {list(by_expiry)}"
            )
        return max(matches, key=lambda p: p.stat().st_mtime)
    today = datetime.now().date()
    available = sorted(
        ((parse_expiry(expiry), expiry) for expiry in by_expiry),
        key=lambda pair: pair[0] or datetime.max,
    )
    future = [(dt, expiry) for dt, expiry in available if dt and dt.date() >= today]
    chosen = (future[0] if future else available[-1])[1]
    return max(by_expiry[chosen], key=lambda p: p.stat().st_mtime)


class IntradayOptionChainStore:
    """Session-scoped raw snapshot store for NIFTY and BANKNIFTY only."""

    def __init__(self, path: Path) -> None:
        self.path = Path(path)
        self.path.parent.mkdir(parents=True, exist_ok=True)
        self.connection = sqlite3.connect(str(self.path), timeout=20.0)
        self.connection.execute("PRAGMA journal_mode=WAL")
        self.connection.execute("PRAGMA synchronous=NORMAL")
        self.connection.execute(
            """
            CREATE TABLE IF NOT EXISTS option_chain_snapshots (
                symbol TEXT NOT NULL,
                expiry TEXT NOT NULL,
                session_date TEXT NOT NULL,
                market_timestamp TEXT NOT NULL,
                received_timestamp TEXT NOT NULL,
                spot REAL NOT NULL,
                atm REAL NOT NULL,
                step REAL NOT NULL,
                rows_json TEXT NOT NULL,
                native_context_json TEXT NOT NULL DEFAULT '{}',
                PRIMARY KEY (symbol, expiry, market_timestamp)
            )
            """
        )
        columns = {str(row[1]) for row in self.connection.execute("PRAGMA table_info(option_chain_snapshots)")}
        if "native_context_json" not in columns:
            self.connection.execute(
                "ALTER TABLE option_chain_snapshots ADD COLUMN native_context_json TEXT NOT NULL DEFAULT '{}'"
            )
        self.connection.execute(
            "CREATE INDEX IF NOT EXISTS ix_intraday_session_symbol ON option_chain_snapshots(session_date, symbol, expiry, market_timestamp)"
        )
        existing = self.connection.execute(
            "SELECT MAX(session_date) FROM option_chain_snapshots"
        ).fetchone()
        self.active_session = str((existing or ("",))[0] or "")
        if self.active_session:
            self.connection.execute(
                "DELETE FROM option_chain_snapshots WHERE session_date <> ?",
                (self.active_session,),
            )
        self.connection.commit()

    def record(self, snapshot: Mapping[str, Any]) -> bool:
        symbol = str(snapshot.get("symbol") or "").upper().strip()
        if symbol not in INTRADAY_HISTORY_SYMBOLS:
            return False
        market_timestamp = str(snapshot.get("market_timestamp") or "").strip()
        session = _observation_session(market_timestamp)
        if not market_timestamp or not re.fullmatch(r"\d{4}-\d{2}-\d{2}", session):
            return False
        # The first valid exchange snapshot of a new session removes older raw
        # sessions. Same-day restarts retain all accumulated observations.
        if self.active_session and session < self.active_session:
            # Around the open, one endpoint can briefly lag another. Never let
            # a stale response erase data already captured for a newer session.
            return False
        if self.active_session != session:
            self.connection.execute(
                "DELETE FROM option_chain_snapshots WHERE session_date <> ?",
                (session,),
            )
            self.active_session = session
        cursor = self.connection.execute(
            """
            INSERT OR IGNORE INTO option_chain_snapshots
            (symbol, expiry, session_date, market_timestamp, received_timestamp, spot, atm, step, rows_json, native_context_json)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            """,
            (
                symbol, str(snapshot.get("expiry") or ""), session, market_timestamp,
                str(snapshot.get("received_timestamp") or ""), sf(snapshot.get("spot")),
                sf(snapshot.get("atm")), sf(snapshot.get("step")),
                json.dumps(list(snapshot.get("full_rows") or ()), separators=(",", ":"), default=str),
                json.dumps({
                    "website_rs_status": snapshot.get("website_rs_status") or {},
                    "reversal_model": snapshot.get("reversal_model") or {},
                    "weekly_range": snapshot.get("weekly_range") or {},
                    "website_native_status": snapshot.get("website_native_status") or "",
                    "website_fetch_time": snapshot.get("website_fetch_time") or "",
                    "operational_source": "PYTHON_EXCHANGE_OPTION_CHAIN",
                }, separators=(",", ":"), default=str),
            ),
        )
        self.connection.commit()
        return cursor.rowcount > 0

    def recent(self, symbol: str, expiry: str, limit: int = 2) -> List[Dict[str, Any]]:
        rows = self.connection.execute(
            """
            SELECT symbol, expiry, session_date, market_timestamp, received_timestamp, spot, atm, step, rows_json, native_context_json
            FROM option_chain_snapshots
            WHERE symbol = ? AND expiry = ?
            ORDER BY market_timestamp DESC LIMIT ?
            """,
            (str(symbol).upper().strip(), str(expiry), max(1, int(limit))),
        ).fetchall()
        result = []
        for row in reversed(rows):
            item = {
                "symbol": row[0], "expiry": row[1], "session_date": row[2],
                "market_timestamp": row[3], "received_timestamp": row[4],
                "spot": row[5], "atm": row[6], "step": row[7],
                "full_rows": json.loads(row[8]),
            }
            try:
                item.update(json.loads(row[9] or "{}"))
            except (ValueError, TypeError):
                pass
            result.append(item)
        return result

    def nine_twenty_anchor(self, symbol: str, expiry: str) -> Optional[Dict[str, Any]]:
        """Return today's stored snapshot closest to 09:20 (09:18-09:25 only).

        A late application start must not relabel a 15:00 calculation as the
        website's frozen 09:20 overlay.  Same-day restarts work because the raw
        NIFTY/BANKNIFTY history is retained until the next session begins.
        """
        rows = self.connection.execute(
            """
            SELECT symbol, expiry, session_date, market_timestamp, received_timestamp,
                   spot, atm, step, rows_json, native_context_json
            FROM option_chain_snapshots
            WHERE symbol = ? AND expiry = ? AND session_date = ?
            ORDER BY market_timestamp ASC
            """,
            (str(symbol).upper().strip(), str(expiry), self.active_session),
        ).fetchall()
        candidates: List[Tuple[float, Tuple[Any, ...]]] = []
        for row in rows:
            try:
                context = json.loads(row[9] or "{}")
            except (ValueError, TypeError):
                context = {}
            if context.get("operational_source") != "PYTHON_EXCHANGE_OPTION_CHAIN":
                continue
            stamp = str(row[3] or "")
            parsed = datetime.min
            for pattern in ("%d-%b-%Y %H:%M:%S", "%d-%m-%Y %H:%M:%S", "%Y-%m-%d %H:%M:%S"):
                try:
                    parsed = datetime.strptime(stamp[:20].strip(), pattern)
                    break
                except ValueError:
                    pass
            if parsed == datetime.min:
                continue
            seconds = parsed.hour * 3600 + parsed.minute * 60 + parsed.second
            target = 9 * 3600 + 20 * 60
            if target - 120 <= seconds <= target + 300:
                candidates.append((abs(seconds - target), row))
        if not candidates:
            return None
        row = min(candidates, key=lambda item: item[0])[1]
        item = {
            "symbol": row[0], "expiry": row[1], "session_date": row[2],
            "market_timestamp": row[3], "received_timestamp": row[4],
            "spot": row[5], "atm": row[6], "step": row[7],
            "full_rows": json.loads(row[8]),
        }
        try:
            item.update(json.loads(row[9] or "{}"))
        except (ValueError, TypeError):
            pass
        return item

    def status(self) -> Dict[str, Any]:
        rows = self.connection.execute(
            """
            SELECT symbol, COUNT(*), MIN(market_timestamp), MAX(market_timestamp)
            FROM option_chain_snapshots GROUP BY symbol ORDER BY symbol
            """
        ).fetchall()
        by_symbol = {
            row[0]: {"snapshots": int(row[1]), "first": row[2], "latest": row[3]}
            for row in rows
        }
        return {
            "enabled": True,
            "symbols": list(INTRADAY_HISTORY_SYMBOLS),
            "session_date": self.active_session or next((str(v["latest"]) for v in by_symbol.values()), "")[:10],
            "database": str(self.path.resolve()),
            "by_symbol": by_symbol,
            "cleanup_rule": "Older raw sessions are deleted when the first valid exchange snapshot of a new session is stored.",
        }

    def close(self) -> None:
        self.connection.close()


_RESTORED_INTRADAY_CONFIRMATIONS: set[str] = set()


def restore_intraday_confirmation(store: IntradayOptionChainStore, snapshot: Mapping[str, Any]) -> int:
    """Restore only the final two observations; that is sufficient for the confirmation rule."""
    symbol, expiry = str(snapshot.get("symbol") or "").upper(), str(snapshot.get("expiry") or "")
    if symbol not in INTRADAY_HISTORY_SYMBOLS:
        return 0
    key = f"{symbol}|{expiry}"
    if key in _RESTORED_INTRADAY_CONFIRMATIONS:
        return 0
    _LINE_CONFIRMATION_STATE.pop(key, None)
    restored = 0
    for saved in store.recent(symbol, expiry, limit=2):
        if saved.get("operational_source") != "PYTHON_EXCHANGE_OPTION_CHAIN":
            continue
        rows = list(saved.get("full_rows") or ())
        if not rows:
            continue
        sp, st, at = sf(saved.get("spot")), sf(saved.get("step")), sf(saved.get("atm"))
        ladder = calculate_ltp_ladder(rows, sp, at, st)
        levels = snapshot_boundary_levels(rows, sp, at, st)
        levels.update(dominance_status(levels, sp))
        build_line_confirmation(
            levels, ladder, sp, st, state_key=key,
            observation_id=saved.get("market_timestamp"),
        )
        restored += 1
    _RESTORED_INTRADAY_CONFIRMATIONS.add(key)
    return restored


class LiveOptionChainClient:
    """Read-only NSE/BSE option-chain client; it has no order endpoints."""

    def __init__(self, timeout: float = 12.0) -> None:
        import requests

        self.requests = requests
        self.timeout = timeout
        self.headers = {
            "User-Agent": (
                "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
                "AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36"
            ),
            "Accept": "application/json,text/plain,*/*",
            "Accept-Language": "en-US,en;q=0.9",
            "Referer": "https://www.nseindia.com/option-chain",
        }
        self.nse = requests.Session()
        self.nse.headers.update(self.headers)
        self.bse = requests.Session()
        self.bse.headers.update({
            **self.headers,
            "Referer": "https://www.bseindia.com/",
            "Origin": "https://www.bseindia.com",
        })
        self.website = requests.Session()
        self.website.headers.update({
            **self.headers,
            "Referer": WEBSITE_RULE_SOURCE_URL,
            "Origin": "https://nseoptionchain.ltpcalculator.com",
        })
        self._prime_nse()
        self._prime_bse()

    def _prime_nse(self) -> None:
        try:
            self.nse.cookies.clear()
            self.nse.get("https://www.nseindia.com/", timeout=self.timeout)
            self.nse.get("https://www.nseindia.com/option-chain", timeout=self.timeout)
        except Exception:
            pass

    def _prime_bse(self) -> None:
        try:
            self.bse.cookies.clear()
            self.bse.get("https://www.bseindia.com/", timeout=self.timeout)
            self.bse.get(
                "https://www.bseindia.com/markets/Derivatives/DeriReports/DeriOptionchain.html",
                timeout=self.timeout,
            )
        except Exception:
            pass

    def _json(self, url: str, bse: bool = False, tries: int = 4) -> Optional[Dict[str, Any]]:
        session = self.bse if bse else self.nse
        for attempt in range(tries):
            try:
                response = session.get(url, timeout=self.timeout)
                if response.status_code in (401, 403, 429):
                    self._prime_bse() if bse else self._prime_nse()
                    time.sleep(0.5 + 0.5 * attempt)
                    continue
                if response.status_code >= 500:
                    time.sleep(0.5 + 0.5 * attempt)
                    continue
                response.raise_for_status()
                payload = response.json()
                return payload if isinstance(payload, dict) else None
            except Exception:
                if attempt + 1 >= tries:
                    return None
                self._prime_bse() if bse else self._prime_nse()
                time.sleep(0.5 + 0.5 * attempt)
        return None

    @staticmethod
    def _website_expiry(expiry: Any) -> str:
        parsed = parse_expiry(expiry)
        # The browser passes its selected expiry verbatim (for example
