def build_wtt_wtb_rule_state(ladder: Mapping[str, Any]) -> Dict[str, Any]:
    """Expose the website WTT/WTB rule and the inputs that produced each side."""
    sides: Dict[str, Any] = {}
    for name, key in (("resistance", "R"), ("support", "S")):
        side = dict(ladder.get(key) or {})
        state = _coa_state(side.get("trade_status"))
        side_effect = {
            "resistance": {
                "WTT": "Resistance is weak towards the top; qualifying secondary pressure is at a higher strike.",
                "WTB": "Resistance is weak towards the bottom; qualifying secondary pressure is at a lower strike.",
            },
            "support": {
                "WTT": "Support is weak towards the top; qualifying secondary pressure is at a higher strike.",
                "WTB": "Support is weak towards the bottom; qualifying secondary pressure is at a lower strike.",
            },
        }
        sides[name] = {
            "state": state,
            "meaning": {
                "STRONG": "Secondary pressure is below the 75% shift threshold.",
                "WTT": side_effect[name]["WTT"],
                "WTB": side_effect[name]["WTB"],
            }.get(state, "No usable leader/shift state."),
            "selected_source": side.get("selected_source", ""),
            "leader_strike": sf(side.get("strike")),
            "shifting_strike": sf(side.get("shifting_strike")),
            "shifting_percentage": round(sf(side.get("ratio")) * 100.0, 2),
            "oi_component": dict(side.get("oi") or {}),
            "volume_component": dict(side.get("vol") or {}),
        }
    return {
        "threshold_percentage": PINK_THRESHOLD * 100.0,
        "direction_rule": "WTT/WTB are side-aware weakness states; the qualifying secondary strike is higher for WTT and lower for WTB",
        "source": "WEBSITE_OPTION_CHAIN_STATUS_AND_COA_1_HELP",
        "source_url": WEBSITE_RULE_SOURCE_URL,
        "sides": sides,
    }


def build_coa_scenario(ladder: Mapping[str, Any]) -> Dict[str, Any]:
    """Classify the live support/resistance pair using the website's COA 1.0 matrix."""
    support = _coa_state(ladder.get("Support_Status"))
    resistance = _coa_state(ladder.get("Resistance_Status"))
    rule = dict(COA_SCENARIO_RULES.get((support, resistance), {}))
    if not rule:
        rule = {
            "scenario_number": 0, "name": "UNAVAILABLE", "sentiment": "UNAVAILABLE",
            "trade_rule": "No trade until both website states are available.",
            "range_rule": "Unavailable", "eos_action": "UNAVAILABLE",
            "eor_action": "UNAVAILABLE", "bias": "UNAVAILABLE",
        }
    return {
        **rule,
        "support_state": support,
        "resistance_state": resistance,
        "eos_trade_allowed": rule["eos_action"] not in {"NO_TRADE", "UNAVAILABLE"},
        "eor_trade_allowed": rule["eor_action"] not in {"NO_TRADE", "UNAVAILABLE"},
        "support_display": website_coa_state_label(support),
