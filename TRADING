def read_open_workbook_selection(book: Any, current_symbol: str, current_expiry: str) -> Tuple[str, str]:
    """Read INDEX/EQ and the matching symbol selector from the live workbook."""
    try:
        ws = book.sheets["LTP_View"]
        current_kind = "INDEX" if current_symbol in INDEX_CONFIG else "EQ"
        selected_kind = str(ws.range("O1").value or current_kind).upper().strip()
        if selected_kind not in {"INDEX", "EQ"}: selected_kind = current_kind
        address = "O2" if selected_kind == "INDEX" else "O3"
        selected_symbol = str(ws.range(address).value or current_symbol).upper().strip()
        if not selected_symbol:
            selected_symbol = current_symbol
        if selected_symbol != current_symbol:
            # Expiries are symbol-specific. Fetch the new symbol's nearest one.
            return selected_symbol, "NEAREST"
        selected_expiry = str(ws.range("O4").value or current_expiry or "NEAREST").strip()
        return selected_symbol, selected_expiry
    except Exception:
        return current_symbol, current_expiry


