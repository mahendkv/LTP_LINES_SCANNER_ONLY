def _website_stock_fetch_date(market_timestamp: Any) -> str:
    text = str(market_timestamp or "").strip()
    for pattern in ("%d-%b-%Y %H:%M:%S", "%d-%m-%Y %H:%M:%S", "%Y-%m-%d %H:%M:%S"):
        try:
            return datetime.strptime(text, pattern).strftime("%d-%m-%Y")
        except ValueError:
            pass
    return datetime.now().strftime("%d-%m-%Y")


def attach_stock_report(
    snapshot: Mapping[str, Any],
    report_file: Optional[Path] = None,
    auth_token: str = "",
) -> Dict[str, Any]:
    """Attach native website stock fields when available; indices are unchanged."""
    enriched = dict(snapshot)
    if snapshot.get("instrument") == "Indices":
        return enriched
    if report_file:
        enriched["stock_report"] = load_stock_report(report_file)
    elif str(auth_token or "").strip():
        enriched["stock_report"] = fetch_stock_report(
            str(snapshot.get("symbol") or ""),
            _website_stock_fetch_date(snapshot.get("market_timestamp")),
            auth_token,
        )
    return enriched


