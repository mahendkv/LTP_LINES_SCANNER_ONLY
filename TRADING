                            excel_app.display_alerts = False
                            try:
                                excel_app.api.EnableAnimations = False
                            except Exception:
                                pass
                            excel_book = excel_app.books.open(str(args.excel.resolve()))
                        except Exception as exc:
                            print(f"Excel live attachment unavailable; continuing file refresh: {exc}", flush=True)
                            excel_book = None
                    first = False
                elif excel_book is not None:
                    refresh_open_workbook(excel_book, display_reference, snapshot["available_expiries"], equity_symbols, market_tracker_rows)
                else:
                    write_reference_workbook(args.excel, display_reference, snapshot["available_expiries"], equity_symbols, market_tracker_rows)
                write_metadata(args.metadata, payload)
                print(
                    f"[{reference['received_timestamp']}] {reference['symbol']} {reference['expiry']} "
                    f"Spot={reference['spot']:.2f} | LIVE {reference['live_six_tv_export']}"
                    f" | AI-LTP {reference['magical_tv_export']}",
                    flush=True,
                )
                last_refresh_error = ""
                if args.once:
                    print("Workbook:", args.excel.resolve())
                    print("Metadata:", args.metadata.resolve())
                    return
            except KeyboardInterrupt:
                raise
            except Exception as exc:
                signature = f"{type(exc).__name__}: {exc}"
                now_error = time.monotonic()
                if signature != last_refresh_error or now_error - last_refresh_error_at >= 300.0:
                    suffix = " NIFTY/BANKNIFTY history collection continues independently." if history_store is not None else ""
                    print(f"Display refresh unavailable: {signature}.{suffix}", flush=True)
                    last_refresh_error = signature
                    last_refresh_error_at = now_error
                if args.once:
                    raise
            time.sleep(args.refresh_seconds)
    except KeyboardInterrupt:
        print("Stopped. The Excel workbook is left open.", flush=True)
    finally:
        if history_store is not None:
            history_store.close()


if __name__ == "__main__":
    main()

